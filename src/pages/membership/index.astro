---
// /membership/（加入會員）。內容以 .source/11-membership.md 與使用者提供的會員頁參考稿為基礎。
// 入會表單使用外部按鈕連結，不嵌入 iframe；匯款帳號依既有官網資料保留。
import BaseLayout from '../../layouts/BaseLayout.astro';

const membershipFormUrl = 'https://forms.gle/PjWC93Uz5ZafzcVD8';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const benefits = [
  {
    number: '01',
    title: '免費／優惠參加研討會',
    body: '享有協會主辦之實體與線上醫療資訊研討會的專屬報名折扣或免費名額。',
  },
  {
    number: '02',
    title: '專屬學術資源庫',
    body: '獲得過往課程講義、AI 工具實作模板及遠距藥事相關文獻的存取權限。',
  },
  {
    number: '03',
    title: '跨領域專業交流',
    body: '加入會員專屬交流群組，與醫師、藥師、護理師及資訊專家建立人脈網絡。',
  },
  {
    number: '04',
    title: '職能認證優先權',
    body: '優先參與「遠距藥事人員」等相關專業職能訓練與證書核發計畫。',
  },
];

const tiers = [
  {
    category: '個人會員',
    qualification: '年滿 20 歲之醫事、社工、資訊或行政人員等',
    initialFee: 'NT$ 1,000',
    annualFee: 'NT$ 2,000',
  },
  {
    category: '學生會員',
    qualification: '醫藥護及資訊相關科系在學學生',
    initialFee: 'NT$ 500',
    annualFee: 'NT$ 500',
  },
  {
    category: '團體會員',
    qualification: '醫療院所、藥商、學術機構等',
    initialFee: 'NT$ 10,000',
    annualFee: 'NT$ 20,000',
  },
];

const steps = [
  { number: '1', title: '線上填寫表單', body: '完整填寫個人或團體資料，以及相關專業背景。' },
  { number: '2', title: '理事會審查', body: '每季度審查一次，審核通過後將寄發入會通知。' },
  { number: '3', title: '依通知繳交會費', body: '繳交入會費與首年常年會費後，正式開通會員權限。' },
];
---

<BaseLayout
  title="加入會員｜臺灣遠距藥事照護協會"
  description="加入臺灣遠距藥事照護協會：了解會員權益、會員類別與收費標準，以及線上申請和繳費流程。"
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">MEMBER CENTER</p>
        <h1>加入會員</h1>
        <p class="hero-lede">串連醫療、藥事與數位科技專業，讓學習資源、實務經驗與跨域合作持續發生。</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={membershipFormUrl} target="_blank" rel="noopener noreferrer">
            填寫入會申請表 <span aria-hidden="true">↗</span>
          </a>
          <a class="btn btn-secondary" href="#membership-options">查看會員類別</a>
        </div>
      </div>
      <ul class="hero-highlights" aria-label="會員專區重點">
        <li><span>專業交流</span><small>連結跨領域夥伴</small></li>
        <li><span>資源共享</span><small>延伸課程與實務學習</small></li>
        <li><span>職能培訓</span><small>優先掌握專業計畫</small></li>
      </ul>
    </div>
  </section>

  <div class="container membership-layout">
    <main class="membership-main">
      <section class="content-section" aria-labelledby="benefits-title">
        <header class="section-heading">
          <p class="section-kicker">MEMBER BENEFITS</p>
          <h2 id="benefits-title">加入 TTPA 的專屬權益</h2>
          <p>從持續學習到跨域交流，協會提供能延伸至工作現場的會員支持。</p>
        </header>

        <ol class="benefit-grid">
          {benefits.map((benefit) => (
            <li class="benefit-card">
              <span class="benefit-number" aria-hidden="true">{benefit.number}</span>
              <div>
                <h3>{benefit.title}</h3>
                <p>{benefit.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="content-section" id="membership-options" aria-labelledby="tiers-title">
        <header class="section-heading compact-heading">
          <p class="section-kicker">MEMBERSHIP OPTIONS</p>
          <h2 id="tiers-title">選擇適合您的會員類別</h2>
          <p>費用分為首次入會費與每年常年會費，實際繳款請依審核通知辦理。</p>
        </header>

        <div class="tier-grid">
          {tiers.map((tier) => (
            <article class="tier-card">
              <h3>{tier.category}</h3>
              <p class="qualification">{tier.qualification}</p>
              <dl>
                <div>
                  <dt>入會費</dt>
                  <dd>{tier.initialFee}</dd>
                  <small>首次繳交</small>
                </div>
                <div>
                  <dt>常年會費</dt>
                  <dd>{tier.annualFee}</dd>
                  <small>每年繳交</small>
                </div>
              </dl>
            </article>
          ))}
        </div>
      </section>
    </main>

    <aside class="apply-aside" aria-labelledby="aside-title">
      <div class="aside-card">
        <p class="aside-label">READY TO JOIN?</p>
        <h2 id="aside-title">準備好加入了嗎？</h2>
        <p>申請採線上填表，經理事會審查通過後，再依通知完成繳費。</p>
        <a class="btn btn-primary aside-button" href={membershipFormUrl} target="_blank" rel="noopener noreferrer">
          開始線上申請 <span aria-hidden="true">↗</span>
        </a>
        <nav class="aside-nav" aria-label="本頁快速導覽">
          <a href="#membership-options">會員類別與費用</a>
          <a href="#application-process">入會申請流程</a>
          <a href="#payment-information">匯款資訊</a>
        </nav>
        <div class="aside-support">
          <span>申請問題</span>
          <a href={`${base}contact/`}>聯絡協會秘書處</a>
        </div>
      </div>
    </aside>
  </div>

  <section class="process-section" id="application-process" aria-labelledby="process-title">
    <div class="container">
      <header class="process-heading">
        <div>
          <p class="section-kicker">APPLICATION PROCESS</p>
          <h2 id="process-title">三個步驟完成入會</h2>
        </div>
        <p>先申請、後審查；收到通知後再繳費，流程更清楚。</p>
      </header>

      <ol class="step-list">
        {steps.map((step) => (
          <li>
            <span class="step-number">{step.number}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <a class="btn process-button" href={membershipFormUrl} target="_blank" rel="noopener noreferrer">
        填寫入會申請表 <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="payment-section" id="payment-information" aria-labelledby="payment-title">
    <div class="container payment-layout">
      <header class="payment-heading">
        <p class="section-kicker">PAYMENT INFORMATION</p>
        <h2 id="payment-title">匯款資訊</h2>
        <p>此資訊供審核通過後繳費使用。請先完成線上申請，並於收到入會通知後再辦理匯款。</p>
      </header>

      <div class="payment-card">
        <dl>
          <div>
            <dt>銀行名稱</dt>
            <dd>台新國際商業銀行 後甲分行</dd>
            <small>銀行代碼：812</small>
          </div>
          <div>
            <dt>戶名</dt>
            <dd>臺灣遠距藥事照護協會</dd>
          </div>
          <div>
            <dt>帳號</dt>
            <dd class="account-number">2035-01-0000581-1</dd>
          </div>
        </dl>
        <p class="payment-note">
          匯款後，請將收據或匯款證明拍照寄至
          <a href="mailto:ttpa2014@gmail.com">ttpa2014@gmail.com</a>，以利後續對帳。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    overflow: hidden;
    background:
      radial-gradient(circle at 86% 12%, color-mix(in srgb, var(--color-accent) 18%, transparent), transparent 24rem),
      var(--color-brand-soft);
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .hero-inner {
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  .hero-copy {
    max-width: 44rem;
  }

  .eyebrow,
  .section-kicker,
  .aside-label {
    margin: 0 0 0.55rem;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .hero h1 {
    margin: 0;
    color: var(--color-primary);
  }

  .hero-lede {
    max-width: 40rem;
    margin: 0.8rem 0 0;
    color: var(--color-ink-soft);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 3rem;
    padding: 0.7rem 1.35rem;
    border: 1px solid transparent;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 800;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .btn:hover,
  .btn:focus-visible {
    transform: translateY(-0.1rem);
  }

  .btn:focus-visible,
  .aside-nav a:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    outline-offset: 3px;
  }

  .btn-primary {
    color: var(--color-white);
    background: var(--color-accent);
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    color: var(--color-white);
    background: var(--color-accent-dark);
  }

  .btn-secondary {
    color: var(--color-primary);
    background: var(--color-white);
    border-color: var(--color-brand-tint);
  }

  .btn-secondary:hover,
  .btn-secondary:focus-visible {
    color: var(--color-primary-dark);
    border-color: var(--color-primary);
  }

  .hero-highlights {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
    list-style: none;
    background: color-mix(in srgb, var(--color-white) 88%, transparent);
    border: 1px solid var(--color-white);
    border-radius: 1rem;
    box-shadow: var(--shadow-card);
  }

  .hero-highlights li {
    display: grid;
    gap: 0.1rem;
    padding: 1rem 1.25rem;
  }

  .hero-highlights li + li {
    border-top: 1px solid var(--color-line);
  }

  .hero-highlights span {
    color: var(--color-primary);
    font-weight: 800;
  }

  .hero-highlights small {
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
  }

  .membership-layout {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  .membership-main {
    display: grid;
    gap: clamp(3rem, 7vw, 5rem);
    min-width: 0;
  }

  .section-heading {
    max-width: 43rem;
    margin-bottom: 1.75rem;
  }

  .section-heading h2,
  .process-heading h2,
  .payment-heading h2,
  .apply-aside h2 {
    margin: 0;
    color: var(--color-primary);
  }

  .section-heading > p:last-child,
  .process-heading > p,
  .payment-heading > p {
    margin: 0.65rem 0 0;
    color: var(--color-ink-soft);
  }

  .benefit-grid {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .benefit-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    min-height: 100%;
    padding: 1.35rem;
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: 0.9rem;
    box-shadow: var(--shadow-card);
  }

  .benefit-number {
    display: grid;
    width: 2.6rem;
    height: 2.6rem;
    place-items: center;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    background: var(--color-brand-soft);
    border-radius: 50%;
  }

  .benefit-card h3,
  .tier-card h3,
  .step-list h3 {
    margin: 0;
    color: var(--color-primary);
    font-size: var(--text-lg);
  }

  .benefit-card p,
  .qualification,
  .step-list p {
    margin: 0.35rem 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .tier-grid {
    display: grid;
    gap: 1rem;
  }

  .tier-card {
    padding: 1.4rem;
    background: var(--color-brand-soft);
    border: 1px solid var(--color-brand-tint);
    border-radius: 0.9rem;
  }

  .qualification {
    min-height: 3.2rem;
  }

  .tier-card dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.2rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-brand-tint);
  }

  .tier-card dl div {
    min-width: 0;
  }

  .tier-card dt {
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
  }

  .tier-card dd {
    margin: 0.2rem 0 0;
    color: var(--color-primary);
    font-size: var(--text-base);
    font-weight: 800;
  }

  .tier-card small,
  .payment-card small {
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
  }

  .aside-card {
    padding: 1.5rem;
    color: var(--color-white);
    background: var(--color-primary-dark);
    border-radius: 1rem;
    box-shadow: var(--shadow-card-hover);
  }

  .aside-label {
    color: var(--color-brand-tint);
  }

  .apply-aside h2 {
    color: var(--color-white);
    font-size: var(--text-xl);
  }

  .aside-card > p:not(.aside-label) {
    margin: 0.65rem 0 0;
    color: var(--color-brand-tint);
    font-size: var(--text-sm);
  }

  .aside-button {
    width: 100%;
    margin-top: 1.25rem;
  }

  .aside-nav {
    display: grid;
    margin-top: 1.5rem;
    padding-top: 0.65rem;
    border-top: 1px solid color-mix(in srgb, var(--color-white) 18%, transparent);
  }

  .aside-nav a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.65rem;
    color: var(--color-white);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-white) 12%, transparent);
    font-size: var(--text-sm);
  }

  .aside-nav a::after {
    content: '↓';
    color: var(--color-brand-tint);
  }

  .aside-nav a:hover {
    color: var(--color-brand-tint);
  }

  .aside-support {
    display: grid;
    gap: 0.15rem;
    margin-top: 1.25rem;
    font-size: var(--text-xs);
  }

  .aside-support span {
    color: var(--color-brand-tint);
  }

  .aside-support a {
    color: var(--color-white);
    font-weight: 800;
  }

  .process-section {
    color: var(--color-white);
    background: var(--color-primary-dark);
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .process-heading {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .process-heading .section-kicker {
    color: var(--color-brand-tint);
  }

  .process-heading h2 {
    color: var(--color-white);
  }

  .process-heading > p {
    max-width: 32rem;
    color: var(--color-brand-tint);
  }

  .step-list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    padding: 1.25rem;
    background: color-mix(in srgb, var(--color-white) 7%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-white) 14%, transparent);
    border-radius: 0.9rem;
  }

  .step-number {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    color: var(--color-primary-dark);
    background: var(--color-brand-tint);
    border-radius: 50%;
    font-weight: 800;
  }

  .step-list h3 {
    color: var(--color-white);
  }

  .step-list p {
    color: var(--color-brand-tint);
  }

  .process-button {
    margin-top: 1.5rem;
    color: var(--color-primary-dark);
    background: var(--color-white);
  }

  .process-button:hover,
  .process-button:focus-visible {
    color: var(--color-primary-dark);
    background: var(--color-brand-tint);
  }

  .payment-section {
    background: var(--color-brand-soft);
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .payment-layout {
    display: grid;
    gap: 1.5rem;
  }

  .payment-heading {
    max-width: 37rem;
  }

  .payment-card {
    padding: clamp(1.25rem, 4vw, 2rem);
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    box-shadow: var(--shadow-card);
  }

  .payment-card dl {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .payment-card dl div {
    display: grid;
    gap: 0.15rem;
  }

  .payment-card dt {
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .payment-card dd {
    margin: 0;
    color: var(--color-primary);
    font-weight: 700;
  }

  .account-number {
    overflow-wrap: anywhere;
    font-size: var(--text-lg);
    letter-spacing: 0.04em;
  }

  .payment-note {
    margin: 1.25rem 0 0;
    padding-top: 1rem;
    color: var(--color-ink-soft);
    border-top: 1px solid var(--color-line);
    font-size: var(--text-sm);
  }

  .payment-note a {
    font-weight: 800;
  }

  @media (min-width: 700px) {
    .hero-highlights,
    .benefit-grid,
    .tier-grid,
    .step-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tier-card:last-child,
    .step-list li:last-child {
      grid-column: span 2;
    }

    .process-heading,
    .payment-layout {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.85fr);
      align-items: end;
    }

    .process-heading > p {
      justify-self: end;
    }
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.25fr) minmax(20rem, 0.75fr);
    }

    .membership-layout {
      grid-template-columns: minmax(0, 1fr) minmax(15.5rem, 0.33fr);
      align-items: start;
    }

    .apply-aside {
      position: sticky;
      top: calc(var(--header-height, 5rem) + 1.5rem);
    }

    .tier-grid,
    .step-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .tier-card:last-child,
    .step-list li:last-child {
      grid-column: auto;
    }

    .payment-layout {
      grid-template-columns: minmax(0, 0.8fr) minmax(28rem, 1.2fr);
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }
  }
</style>
