---
// /courses/（線上課程推廣）列表頁。
// 課程卡片由 courses 內容集合自動生成；專訪影音一併整合成一致的學習專區介面。
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const courses = await getCollection('courses');

const getCourseStatusLabel = (status?: string) => {
  if (!status) return '狀態待更新';
  return /已結束|已圓滿結束/.test(status) ? '已結束' : '報名中';
};

const learningItems = [
  ...courses.map((course) => ({
    key: `course-${course.id}`,
    kind: '線上課程',
    title: course.data.title,
    dateLabel: course.data.dateLabel,
    sortDate: course.data.date?.getTime() ?? 0,
    speakerLabel: '講師',
    speaker: course.data.instructorName ?? '待公布',
    status: getCourseStatusLabel(course.data.status),
    summary: course.data.summary,
    href: `${base}courses/${course.id}/`,
    cta: '查看詳細資訊',
    external: false,
  })),
  {
    key: 'interview-2026-01-21-chairman',
    kind: '專訪影音',
    title: '劉孟基理事長專訪（上）',
    dateLabel: '2026 年 1 月 21 日',
    sortDate: new Date('2026-01-21').getTime(),
    speakerLabel: '受訪者',
    speaker: '劉孟基理事長',
    status: '影音回顧',
    summary: '創立臺灣遠距藥事照護協會的初衷。',
    href: 'https://drive.google.com/file/d/1JW2L2AyFHqW62sjHQr0nELKmCNOk7_7-/preview',
    cta: '觀看專訪',
    external: true,
  },
].sort((a, b) => b.sortDate - a.sortDate);
---

<BaseLayout
  title="線上課程推廣 | 臺灣遠距藥事照護協會"
  description="臺灣遠距藥事照護協會線上課程與專訪影音：瀏覽課程主題、時間、講師、報名狀態及完整資訊。"
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">TTPA LEARNING HUB</p>
      <h1>線上課程推廣</h1>
      <p class="hero-lede">從實務課程到專業專訪，集中瀏覽時間、講師與最新狀態，找到適合自己的學習內容。</p>
      <div class="hero-tags" aria-label="學習內容類型">
        <span>醫療專業</span>
        <span>AI 應用</span>
        <span>專訪影音</span>
      </div>
    </div>
  </section>

  <section class="list">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">COURSES & INTERVIEWS</p>
        <h2>課程與專訪</h2>
        <p>依日期由新到舊排列；點選任一區塊即可查看課程詳情或觀看專訪。</p>
      </div>

      <div class="list-grid">
        {
          learningItems.map((item) => (
            <a
              class="course-card"
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              <div class="card-topline">
                <span class="content-type">{item.kind}</span>
                <StatusBadge status={item.status} />
              </div>

              <h3>{item.title}</h3>

              <dl class="course-meta">
                <div class="course-meta-row">
                  <dt>時間</dt>
                  <dd>{item.dateLabel}</dd>
                </div>
                <div class="course-meta-row">
                  <dt>{item.speakerLabel}</dt>
                  <dd>{item.speaker}</dd>
                </div>
              </dl>

              {item.summary && <p class="course-summary">{item.summary}</p>}
              <span class="cta">{item.cta} <span aria-hidden="true">→</span></span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--color-brand-soft);
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  .hero::after {
    content: '';
    position: absolute;
    width: 18rem;
    height: 18rem;
    right: -5rem;
    bottom: -8rem;
    border: 2.5rem solid var(--color-brand-tint);
    border-radius: 50%;
    opacity: 0.65;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .hero h1 {
    margin: 0;
    color: var(--color-primary-dark);
  }

  .hero-lede {
    max-width: 44rem;
    margin: 1rem auto 0;
    color: var(--color-ink-soft);
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .hero-tags span {
    padding: 0.35rem 1rem;
    border: 1px solid var(--color-brand-tint);
    border-radius: 999rem;
    background: var(--color-white);
    color: var(--color-primary-dark);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .list {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .section-heading {
    max-width: 44rem;
    margin: 0 auto 2rem;
    text-align: center;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--color-primary-dark);
  }

  .section-heading > p:last-child {
    margin: 0.75rem 0 0;
    color: var(--color-ink-soft);
  }

  .list-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  .course-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 100%;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background: var(--color-white);
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    text-decoration: none;
  }

  .course-card:hover {
    color: var(--color-text);
  }

  .card-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .content-type {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .course-card h3 {
    margin: 0;
    color: var(--color-primary);
    font-size: var(--text-lg);
  }

  .course-meta {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-block: 0.85rem;
    border-block: 1px solid var(--color-line);
  }

  .course-meta-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
  }

  .course-meta dt {
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .course-meta dd {
    margin: 0;
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  .course-summary {
    flex-grow: 1;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .course-card .cta {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 800;
  }

  @media (min-width: 768px) {
    .list-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
