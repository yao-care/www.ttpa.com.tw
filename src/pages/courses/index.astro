---
// /courses/（線上教學資料庫）列表頁。
// 課程卡片由 courses 內容集合自動生成；專訪影音一併整合於線上課程區。
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const courses = await getCollection('courses');

const getCourseStatusLabel = (status?: string) => {
  if (!status) return '狀態待更新';
  if (/候補/.test(status)) return '限額候補';
  return /已結束|已圓滿結束/.test(status) ? '已結束' : '報名中';
};

const learningItems = [
  ...courses.map((course) => ({
    key: `course-${course.id}`,
    kind: '線上課程',
    title: course.data.title,
    dateLabel: course.data.dateLabel,
    sortDate: course.data.date?.getTime() ?? 0,
    speakerLabel: '講師',
    speaker: course.data.instructorName ?? '待公布',
    status: getCourseStatusLabel(course.data.status),
    summary: course.data.summary,
    href: `${base}courses/${course.id}/`,
    cta: '查看詳細資訊',
    external: false,
  })),
  {
    key: 'interview-2026-01-21-chairman',
    kind: '專訪影音',
    title: '劉孟基理事長專訪（上）',
    dateLabel: '2026 年 1 月 21 日',
    sortDate: new Date('2026-01-21').getTime(),
    speakerLabel: '受訪者',
    speaker: '劉孟基理事長',
    status: '影音回顧',
    summary: '創立臺灣遠距藥事照護協會的初衷。',
    href: 'https://drive.google.com/file/d/1JW2L2AyFHqW62sjHQr0nELKmCNOk7_7-/preview',
    cta: '觀看專訪',
    external: true,
  },
].sort((a, b) => b.sortDate - a.sortDate);
---

<BaseLayout
  title="線上教學資料庫 | 臺灣遠距藥事照護協會"
  description="臺灣遠距藥事照護協會的線上課程、專訪影音與經授權教材入口：瀏覽課程主題、時間、講師、狀態及完整資訊。"
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">TTPA LEARNING HUB</p>
      <h1>線上教學資料庫</h1>
      <p class="hero-lede">從實務課程與專業專訪，到經確認開放的教材資源；依需求選擇學習入口，掌握最新狀態與內容。</p>
      <div class="hero-tags" aria-label="學習內容類型">
        <span>醫療專業</span>
        <span>AI 應用</span>
        <span>專訪影音</span>
      </div>
      <nav class="section-links" aria-label="資料庫分區">
        <a href="#online-courses">線上課程區 <span aria-hidden="true">↓</span></a>
        <a href="#teaching-materials">線上教材區 <span aria-hidden="true">↓</span></a>
      </nav>
    </div>
  </section>

  <section id="online-courses" class="list" aria-labelledby="online-courses-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">COURSES & INTERVIEWS</p>
        <h2 id="online-courses-title">線上課程區</h2>
        <p>收錄線上課程與協會專訪影音，依日期由新到舊排列；點選任一區塊即可查看詳情或觀看內容。</p>
      </div>

      <div class="list-grid">
        {
          learningItems.map((item) => (
            <a
              class="course-card"
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              <div class="card-topline">
                <span class="content-type">{item.kind}</span>
                <StatusBadge status={item.status} />
              </div>

              <h3>{item.title}</h3>

              <dl class="course-meta">
                <div class="course-meta-row">
                  <dt>時間</dt>
                  <dd>{item.dateLabel}</dd>
                </div>
                <div class="course-meta-row">
                  <dt>{item.speakerLabel}</dt>
                  <dd>{item.speaker}</dd>
                </div>
              </dl>

              {item.summary && <p class="course-summary">{item.summary}</p>}
              <span class="cta">{item.cta} <span aria-hidden="true">→</span></span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section id="teaching-materials" class="materials" aria-labelledby="teaching-materials-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">TEACHING MATERIALS</p>
        <h2 id="teaching-materials-title">線上教材區</h2>
        <p>經協會確認開放的教材、講義與內部資源將集中於此；教材內容確認後才會上架。</p>
      </div>

      <div class="materials-gate">
        <div data-materials-locked>
          <div class="materials-lock" aria-hidden="true">🔒</div>
          <p class="gate-kicker">MATERIAL ACCESS</p>
          <h3>教材存取驗證</h3>
          <p>請輸入協會提供的存取碼，以進入已開放的教材資訊區。</p>

          <form class="materials-form" data-materials-form>
            <label for="materials-passcode">教材存取碼</label>
            <div class="materials-form-row">
              <input
                id="materials-passcode"
                name="materials-passcode"
                type="password"
                inputmode="text"
                autocomplete="off"
                spellcheck="false"
                required
                aria-describedby="materials-help materials-error"
                data-materials-passcode
              />
              <button type="submit">驗證並進入</button>
            </div>
            <p id="materials-help" class="materials-help">教材尚未開放時，驗證後會顯示最新整理狀態。</p>
            <p id="materials-error" class="materials-error" data-materials-error hidden aria-live="polite">存取碼不正確，請確認後再試。</p>
          </form>
        </div>

        <div class="materials-unlocked" data-materials-unlocked hidden tabindex="-1">
          <p class="eyebrow">ACCESS CONFIRMED</p>
          <h3>線上教材區正在整理中</h3>
          <p>教材內容待協會確認後開放；完成確認的教材會直接在此提供瀏覽或下載連結。</p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const materialsForm = document.querySelector<HTMLFormElement>('[data-materials-form]');
  const materialsPasscode = document.querySelector<HTMLInputElement>('[data-materials-passcode]');
  const materialsError = document.querySelector<HTMLElement>('[data-materials-error]');
  const materialsLocked = document.querySelector<HTMLElement>('[data-materials-locked]');
  const materialsUnlocked = document.querySelector<HTMLElement>('[data-materials-unlocked]');

  if (materialsForm && materialsPasscode && materialsError && materialsLocked && materialsUnlocked) {
    materialsForm.addEventListener('submit', (event) => {
      event.preventDefault();

      if (materialsPasscode.value.trim() === 'ttpa2014') {
        materialsLocked.hidden = true;
        materialsError.hidden = true;
        materialsUnlocked.hidden = false;
        materialsUnlocked.focus();
        return;
      }

      materialsError.hidden = false;
      materialsPasscode.focus();
    });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--color-brand-soft);
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  .hero::after {
    content: '';
    position: absolute;
    width: 18rem;
    height: 18rem;
    right: -5rem;
    bottom: -8rem;
    border: 2.5rem solid var(--color-brand-tint);
    border-radius: 50%;
    opacity: 0.65;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .hero h1 {
    margin: 0;
    color: var(--color-primary-dark);
  }

  .hero-lede {
    max-width: 44rem;
    margin: 1rem auto 0;
    color: var(--color-ink-soft);
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .hero-tags span {
    padding: 0.35rem 1rem;
    border: 1px solid var(--color-brand-tint);
    border-radius: 999rem;
    background: var(--color-white);
    color: var(--color-primary-dark);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .section-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .section-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 1rem;
    border-radius: 999rem;
    background: var(--color-primary);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: 800;
    text-decoration: none;
  }

  .section-links a:hover {
    background: var(--color-primary-dark);
    color: var(--color-white);
  }

  .list {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    scroll-margin-top: calc(var(--site-header-height) + 1rem);
  }

  .section-heading {
    max-width: 44rem;
    margin: 0 auto 2rem;
    text-align: center;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--color-primary-dark);
  }

  .section-heading > p:last-child {
    margin: 0.75rem 0 0;
    color: var(--color-ink-soft);
  }

  .list-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  .course-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 100%;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background: var(--color-white);
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    text-decoration: none;
  }

  .course-card:hover {
    color: var(--color-text);
  }

  .card-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .content-type {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .course-card h3 {
    margin: 0;
    color: var(--color-primary);
    font-size: var(--text-lg);
  }

  .course-meta {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-block: 0.85rem;
    border-block: 1px solid var(--color-line);
  }

  .course-meta-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
  }

  .course-meta dt {
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .course-meta dd {
    margin: 0;
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  .course-summary {
    flex-grow: 1;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .course-card .cta {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 800;
  }

  .materials {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    scroll-margin-top: calc(var(--site-header-height) + 1rem);
    background: var(--color-brand-soft);
  }

  .materials-gate {
    max-width: 44rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--color-brand-tint);
    border-radius: 1.25rem;
    background: var(--color-white);
    box-shadow: var(--shadow-card);
    text-align: center;
  }

  .materials-lock {
    display: grid;
    width: 3.25rem;
    height: 3.25rem;
    margin: 0 auto 0.9rem;
    place-items: center;
    border-radius: 50%;
    background: var(--color-brand-soft);
    font-size: var(--text-lg);
  }

  .gate-kicker {
    margin: 0;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .materials-gate h3 {
    margin: 0.35rem 0 0;
    color: var(--color-primary-dark);
  }

  .materials-gate h3 + p {
    max-width: 34rem;
    margin: 0.75rem auto 0;
    color: var(--color-ink-soft);
  }

  .materials-form {
    max-width: 34rem;
    margin: 1.5rem auto 0;
    text-align: left;
  }

  .materials-form label {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--color-primary-dark);
    font-size: var(--text-sm);
    font-weight: 800;
  }

  .materials-form-row {
    display: grid;
    gap: 0.65rem;
  }

  .materials-form input {
    min-width: 0;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--color-line);
    border-radius: 0.65rem;
    color: var(--color-text);
    font: inherit;
  }

  .materials-form input:focus {
    outline: 3px solid var(--color-brand-tint);
    outline-offset: 2px;
  }

  .materials-form button {
    border: 0;
    border-radius: 0.65rem;
    padding: 0.7rem 1rem;
    background: var(--color-accent);
    color: var(--color-white);
    cursor: pointer;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 800;
  }

  .materials-form button:hover {
    background: var(--color-accent-dark);
  }

  .materials-help,
  .materials-error {
    margin: 0.65rem 0 0;
    font-size: var(--text-xs);
  }

  .materials-help {
    color: var(--color-ink-muted);
  }

  .materials-error {
    color: var(--color-primary-dark);
    font-weight: 700;
  }

  .materials-unlocked {
    outline: none;
  }

  .materials-unlocked .eyebrow {
    margin-top: 0;
  }

  @media (min-width: 768px) {
    .list-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .materials-form-row {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
