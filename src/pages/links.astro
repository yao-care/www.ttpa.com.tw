---
// 官方連結。內容逐字取自 .source/12-links.md（頁面上全部 2 筆連結項目）。
// Facebook 連結文字版與縮圖版目的地不同（見 12-links.md:26-30），依交辦指示採文字連結版，
// 即官方粉專首頁 https://www.facebook.com/telepharmacy/。皆為外部連結，不受 BASE_URL 規則限制。
import BaseLayout from '../layouts/BaseLayout.astro';

// 逐字取自 12-links.md 表格
const links = [
  { label: 'TTPA 臺灣遠距藥事照護協會', href: 'https://www.facebook.com/telepharmacy/' },
  { label: '臺中市政府衛生局全球資訊網', href: 'https://www.health.taichung.gov.tw/' },
];
---

<BaseLayout
  title="官方連結 | 臺灣遠距藥事照護協會 Taiwan Telepharmacy Association"
  description="官方連結"
>
  <section class="page">
    <div class="container">
      <h1>官方連結</h1>

      <ul class="link-list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  h1 {
    color: var(--color-primary);
    margin-block: 0 2rem;
  }

  .link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 32rem;
  }

  .link-list a {
    display: block;
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    box-shadow: var(--shadow-card);
    padding: 1.25rem 1.5rem;
    font-weight: 600;
    text-decoration: none;
  }

  .link-list a:hover {
    box-shadow: var(--shadow-card-hover);
    color: var(--color-accent);
  }
</style>
