---
// 保留既有 /links/ 正式網址，將原「官方連結」升級為可擴充的合作夥伴與講師入口。
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const asset = (path: string) => `${base}${path}`;
const partners = (await getCollection('partners')).sort((a, b) => a.data.order - b.data.order);
const instructors = (await getCollection('instructors')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="合作夥伴｜臺灣遠距藥事照護協會"
  description="認識臺灣遠距藥事照護協會的合作單位與專業講師群，瀏覽合作單位官網、講師專長、資歷與授課紀錄。"
>
  <main class="partners-page">
    <section class="hero">
      <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
      <div class="hero-orb hero-orb-two" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">PARTNERS &amp; FACULTY</p>
          <h1>讓專業彼此連結，<br /><em>一起把照護帶得更遠</em></h1>
          <p class="hero-lede">集中呈現與協會同行的合作單位，以及參與醫療、藥事、AI 與數位工具培訓的講師群。</p>
          <nav class="hero-actions" aria-label="合作夥伴頁面導覽">
            <a class="button button-primary" href="#organizations">瀏覽合作單位</a>
            <a class="button button-secondary" href="#faculty">認識講師群</a>
          </nav>
        </div>

        <div class="hero-panel" aria-label="頁面內容摘要">
          <div class="hero-panel-mark" aria-hidden="true">TTPA</div>
          <div class="hero-stat-grid">
            <div>
              <strong>{partners.length}</strong>
              <span>合作單位</span>
            </div>
            <div>
              <strong>{instructors.length}</strong>
              <span>講師資料</span>
            </div>
          </div>
          <p>合作連結與講師資料分區管理，日後可直接新增，不必重新設計頁面。</p>
        </div>
      </div>
    </section>

    <section id="organizations" class="section organizations" aria-labelledby="organizations-title">
      <div class="container">
        <header class="section-heading split-heading">
          <div>
            <p class="eyebrow">COLLABORATING ORGANIZATIONS</p>
            <h2 id="organizations-title">合作單位</h2>
          </div>
          <p>顯示單位完整名稱與識別標誌；點選卡片可前往該單位的官方資訊網站。</p>
        </header>

        <div class="partner-grid">
          {
            partners.map((partner) => (
              <a class="partner-card" href={partner.data.website} target="_blank" rel="noopener noreferrer">
                <div class="partner-logo">
                  <img
                    src={asset(partner.data.logo)}
                    alt={partner.data.logoAlt}
                    width="420"
                    height="220"
                    loading="lazy"
                  />
                </div>
                <div class="partner-copy">
                  <span class="card-label">合作單位</span>
                  <h3>{partner.data.name}</h3>
                  <span class="card-link">前往官方網站 <span aria-hidden="true">↗</span></span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section id="faculty" class="section faculty" aria-labelledby="faculty-title">
      <div class="container">
        <header class="section-heading split-heading">
          <div>
            <p class="eyebrow">PROFESSIONAL FACULTY</p>
            <h2 id="faculty-title">講師群</h2>
          </div>
          <p>先掌握講師姓名、現職與專長，再進入個人頁查看完整資歷及授課紀錄。</p>
        </header>

        <div class="faculty-grid">
          {
            instructors.map((instructor) => (
              <a class="faculty-card" href={`${base}links/instructors/${instructor.id}/`}>
                <div class="faculty-photo">
                  <img
                    src={asset(instructor.data.photo)}
                    alt={instructor.data.photoAlt}
                    width="800"
                    height="800"
                    loading="lazy"
                  />
                </div>
                <div class="faculty-copy">
                  <span class="card-label">專業講師</span>
                  <h3>{instructor.data.name}</h3>
                  <p class="faculty-role">{instructor.data.role}</p>
                  <ul class="specialty-list" aria-label={`${instructor.data.name}專長`}>
                    {instructor.data.specialties.map((specialty) => <li>{specialty}</li>)}
                  </ul>
                  <span class="card-link">查看詳細資歷 <span aria-hidden="true">→</span></span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <div class="container closing-inner">
        <div>
          <p class="eyebrow">WORK WITH TTPA</p>
          <h2 id="closing-title">想邀請講師或洽談合作？</h2>
          <p>請透過協會聯絡窗口提供主題、對象與預計時間，我們將協助確認合適的合作方式。</p>
        </div>
        <a class="button button-light" href={`${base}contact/`}>聯絡協會 <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .partners-page {
    overflow: clip;
    background: var(--color-white);
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 7rem);
    background: linear-gradient(145deg, var(--color-brand-soft), var(--color-white));
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    background: var(--color-workshop-a10);
    filter: blur(1rem);
    pointer-events: none;
  }

  .hero-orb-one {
    width: 24rem;
    height: 24rem;
    top: -10rem;
    right: -8rem;
  }

  .hero-orb-two {
    width: 15rem;
    height: 15rem;
    bottom: -7rem;
    left: -5rem;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .eyebrow {
    margin: 0 0 0.65rem;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .hero h1 {
    margin: 0;
    color: var(--color-primary-dark);
    font-size: var(--text-2xl);
    line-height: 1.12;
  }

  .hero h1 em {
    color: var(--color-primary);
    font-style: normal;
  }

  .hero-lede {
    max-width: 42rem;
    margin: 1.25rem 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-base);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .button {
    display: inline-flex;
    min-height: 3.5rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid transparent;
    border-radius: 0.9rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-0.15rem);
    box-shadow: var(--shadow-card-hover);
  }

  .button-primary {
    background: var(--color-accent);
    color: var(--color-white);
  }

  .button-primary:hover,
  .button-primary:focus-visible {
    background: var(--color-accent-dark);
    color: var(--color-white);
  }

  .button-secondary {
    border-color: var(--color-brand-tint);
    background: var(--color-white);
    color: var(--color-primary-dark);
  }

  .hero-panel {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--color-brand-tint);
    border-radius: 1.75rem;
    background: var(--color-white);
    box-shadow: var(--shadow-card-hover);
  }

  .hero-panel-mark {
    display: grid;
    width: 5rem;
    height: 5rem;
    place-items: center;
    border-radius: 1.25rem;
    background: var(--color-primary-dark);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: 900;
    letter-spacing: 0.05em;
  }

  .hero-stat-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-block: 1.5rem;
  }

  .hero-stat-grid div {
    padding: 1rem;
    border-radius: 1rem;
    background: var(--color-brand-soft);
  }

  .hero-stat-grid strong,
  .hero-stat-grid span {
    display: block;
  }

  .hero-stat-grid strong {
    color: var(--color-primary);
    font-size: var(--text-xl);
  }

  .hero-stat-grid span,
  .hero-panel > p {
    color: var(--color-ink-soft);
    font-size: var(--text-xs);
  }

  .hero-panel > p {
    margin: 0;
  }

  .section {
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .organizations {
    background: var(--color-white);
  }

  .faculty {
    background: var(--color-brand-soft);
  }

  .section-heading {
    margin-bottom: 2.5rem;
  }

  .section-heading h2,
  .closing h2 {
    margin: 0;
    color: var(--color-primary-dark);
    font-size: var(--text-2xl);
  }

  .section-heading > p,
  .split-heading > p {
    max-width: 38rem;
    margin: 0.75rem 0 0;
    color: var(--color-ink-soft);
  }

  .partner-grid,
  .faculty-grid {
    display: grid;
    gap: 1.25rem;
  }

  .partner-card,
  .faculty-card {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    background: var(--color-white);
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    text-decoration: none;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .partner-card:hover,
  .partner-card:focus-visible,
  .faculty-card:hover,
  .faculty-card:focus-visible {
    color: var(--color-text);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-0.3rem);
  }

  .partner-logo {
    display: grid;
    min-height: 11rem;
    place-items: center;
    padding: 1.5rem;
    background: var(--color-bg-light);
  }

  .partner-logo img {
    width: 100%;
    max-width: 12rem;
    max-height: 6rem;
    object-fit: contain;
  }

  .partner-copy,
  .faculty-copy {
    padding: 1.4rem;
  }

  .card-label {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .partner-card h3,
  .faculty-card h3 {
    margin: 0;
    color: var(--color-primary-dark);
    font-size: var(--text-lg);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 800;
  }

  .faculty-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
  }

  .faculty-photo {
    overflow: hidden;
    background: var(--color-brand-tint);
  }

  .faculty-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .faculty-card:hover .faculty-photo img,
  .faculty-card:focus-visible .faculty-photo img {
    transform: scale(1.025);
  }

  .faculty-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .faculty-role {
    margin: 0.5rem 0 1rem;
    color: var(--color-ink-soft);
    font-size: var(--text-xs);
  }

  .specialty-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .specialty-list li {
    padding: 0.25rem 0.65rem;
    border-radius: 999rem;
    background: var(--color-brand-soft);
    color: var(--color-primary-dark);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .faculty-copy .card-link {
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .closing {
    padding-block: clamp(3rem, 7vw, 5rem);
    background: var(--color-primary-dark);
  }

  .closing-inner {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .closing .eyebrow {
    color: var(--color-brand-tint);
  }

  .closing h2,
  .closing p {
    color: var(--color-white);
  }

  .closing p:last-child {
    max-width: 50rem;
    margin: 0.75rem 0 0;
  }

  .button-light {
    background: var(--color-white);
    color: var(--color-primary-dark);
  }

  @media (min-width: 768px) {
    .hero h1 {
      font-size: var(--text-3xl);
    }

    .hero-lede {
      font-size: var(--text-lg);
    }

    .partner-grid,
    .faculty-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .split-heading,
    .closing-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.8fr);
      gap: 2rem;
      align-items: end;
    }

    .split-heading > p {
      margin: 0;
    }

    .closing-inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(19rem, 0.7fr);
      gap: 4rem;
    }

    .faculty-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .partner-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .partner-card,
    .faculty-card,
    .faculty-photo img,
    .button {
      transition: none;
    }
  }
</style>
