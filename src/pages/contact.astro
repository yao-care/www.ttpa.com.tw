---
import BaseLayout from '../layouts/BaseLayout.astro';

const contactTopics = ['入會與會籍', '活動與課程', '跨域合作', '一般行政'];
const mapUrl = 'https://www.google.com/maps/search/?api=1&query=臺中市東區東義街6巷6號1樓';
---

<BaseLayout
  title="聯絡我們 | 臺灣遠距藥事照護協會 Taiwan Telepharmacy Association"
  description="聯絡臺灣遠距藥事照護協會秘書處，洽詢會員服務、活動課程、跨域合作與一般行政事務。"
>
  <main class="contact-page">
    <header class="contact-hero">
      <div class="hero-pattern" aria-hidden="true"></div>
      <div class="container hero-inner">
        <p class="eyebrow">CONTACT TTPA</p>
        <h1>聯絡我們</h1>
        <p class="hero-lede">
          無論是會員服務、活動課程或合作提案，協會秘書處將協助您找到合適的窗口。
        </p>
      </div>
    </header>

    <section class="contact-section" aria-labelledby="contact-heading">
      <div class="container contact-layout">
        <aside class="service-guide">
          <p class="section-label">HOW WE CAN HELP</p>
          <h2 id="contact-heading">您想洽詢哪一類服務？</h2>
          <p>
            請於來信時簡述姓名、所屬單位與需求主旨，方便秘書處更快掌握問題並回覆。
          </p>
          <ul class="topic-list" aria-label="可洽詢服務">
            {contactTopics.map((topic) => <li>{topic}</li>)}
          </ul>
        </aside>

        <div class="contact-content">
          <div class="action-grid">
            <a class="action-card action-card-primary" href="mailto:ttpa2014@gmail.com?subject=TTPA 官網聯絡">
              <span class="action-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M3 5.5h18v13H3z"></path>
                  <path d="m4 7 8 6 8-6"></path>
                </svg>
              </span>
              <span class="action-copy">
                <span class="action-label">電子郵件</span>
                <strong>ttpa2014@gmail.com</strong>
                <span class="action-hint">撰寫信件 <span aria-hidden="true">→</span></span>
              </span>
            </a>

            <a class="action-card" href="tel:0911095529">
              <span class="action-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M7.2 3.5 4.5 5.1c.1 7.2 7.2 14.3 14.4 14.4l1.6-2.7-4-3-2.1 2.1a13.5 13.5 0 0 1-6.3-6.3l2.1-2.1z"></path>
                </svg>
              </span>
              <span class="action-copy">
                <span class="action-label">聯絡電話</span>
                <strong>0911-095-529</strong>
                <span class="action-hint">直接撥號 <span aria-hidden="true">→</span></span>
              </span>
            </a>
          </div>

          <section class="office-card" aria-labelledby="office-heading">
            <div class="office-heading">
              <p class="section-label">SECRETARIAT</p>
              <h2 id="office-heading">協會秘書處</h2>
            </div>

            <dl class="office-details">
              <div>
                <dt>聯絡窗口</dt>
                <dd>TTPA 秘書處 邱昶智 秘書長</dd>
              </div>
              <div>
                <dt>服務時段</dt>
                <dd>週一至週五 08:00–17:00</dd>
              </div>
              <div class="address-row">
                <dt>協會地址</dt>
                <dd>臺中市東區東義街 6 巷 6 號 1 樓</dd>
              </div>
            </dl>

            <a class="map-link" href={mapUrl} target="_blank" rel="noopener noreferrer">
              在 Google 地圖開啟 <span aria-hidden="true">↗</span>
            </a>
          </section>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .contact-page {
    background: var(--color-bg-light);
  }

  .contact-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.25rem, 8vw, 5.5rem);
    border-bottom: 1px solid var(--color-brand-tint);
    background: linear-gradient(145deg, var(--color-brand-soft), var(--color-white));
  }

  .hero-pattern {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--color-workshop-a10) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-workshop-a10) 1px, transparent 1px);
    background-size: 3rem 3rem;
    mask-image: linear-gradient(to right, var(--color-primary-dark), transparent 78%);
    opacity: 0.38;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .eyebrow,
  .section-label {
    margin: 0;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0.35rem 0 0.8rem;
    color: var(--color-primary-dark);
    font-size: var(--text-3xl);
  }

  .hero-lede {
    max-width: 45rem;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-base);
  }

  .contact-section {
    padding-block: clamp(2.5rem, 7vw, 5.5rem);
  }

  .contact-layout {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .service-guide {
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border-radius: 1.5rem;
    background: var(--color-primary-dark);
    color: var(--color-white);
    box-shadow: var(--shadow-card);
  }

  .service-guide .section-label {
    color: var(--color-brand-tint);
  }

  .service-guide h2 {
    margin: 0.5rem 0 0.8rem;
    color: var(--color-white);
    font-size: var(--text-xl);
  }

  .service-guide p:not(.section-label) {
    margin: 0;
    color: var(--color-brand-tint);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .topic-list li {
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--color-white-a20);
    border-radius: 999rem;
    background: var(--color-white-a10);
    color: var(--color-white);
    font-size: var(--text-xs);
  }

  .contact-content {
    display: grid;
    gap: 1.25rem;
  }

  .action-grid {
    display: grid;
    gap: 1rem;
  }

  .action-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    min-height: 12rem;
    padding: clamp(1.2rem, 3vw, 1.5rem);
    border: 1px solid var(--color-line);
    border-radius: 1.4rem;
    background: var(--color-white);
    color: var(--color-primary-dark);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .action-card:hover,
  .action-card:focus-visible {
    border-color: var(--color-primary);
    color: var(--color-primary-dark);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-0.2rem);
  }

  .action-card-primary {
    border-color: var(--color-brand-tint);
    background: var(--color-brand-soft);
  }

  .action-icon {
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    border-radius: 1rem;
    background: var(--color-white);
    color: var(--color-primary);
    box-shadow: var(--shadow-card);
  }

  .action-icon svg {
    width: 1.7rem;
    height: 1.7rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .action-copy {
    display: grid;
    min-width: 0;
  }

  .action-label {
    color: var(--color-ink-soft);
    font-size: var(--text-xs);
  }

  .action-copy strong {
    overflow-wrap: anywhere;
    font-size: var(--text-sm);
  }

  .action-hint {
    margin-top: 0.55rem;
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .office-card {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 2rem);
    border: 1px solid var(--color-line);
    border-radius: 1.4rem;
    background: var(--color-white);
  }

  .office-heading h2 {
    margin: 0.35rem 0 0;
    color: var(--color-primary-dark);
    font-size: var(--text-xl);
  }

  .office-details {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .office-details div {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-line);
  }

  .office-details div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .office-details dt {
    margin-bottom: 0.2rem;
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
  }

  .office-details dd {
    margin: 0;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .map-link {
    width: fit-content;
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 700;
    text-underline-offset: 0.25rem;
  }

  .map-link:hover,
  .map-link:focus-visible {
    color: var(--color-accent);
  }

  @media (min-width: 640px) {
    .action-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 768px) {
    .office-card {
      grid-template-columns: minmax(11rem, 0.7fr) minmax(0, 1.3fr);
    }

    .map-link {
      grid-column: 2;
    }
  }

  @media (min-width: 1024px) {
    .contact-layout {
      grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.7fr);
    }

    .service-guide {
      position: sticky;
      top: calc(var(--site-header-height) + 1.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .action-card {
      transition: none;
    }
  }
</style>
