---
// 聯絡我們。內容逐字取自 .source/04-contact.md（資訊卡片區塊）。
// 原站僅提供聯絡窗口、電話、Email 三項，無地址、無傳真、無辦公時間（04-contact.md:56 擷取者已註明
// 「原站無此資訊」），依交辦「不要編」原則，本頁不補上述缺項。
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="聯絡我們 | 臺灣遠距藥事照護協會 Taiwan Telepharmacy Association"
  description="聯絡窗口：TTPA 秘書處 邱昶智 秘書長。"
>
  <section class="page">
    <div class="container">
      <p class="eyebrow">Contact Us</p>
      <h1>聯絡我們</h1>

      <div class="card">
        <h2>聯絡資訊</h2>
        <ul class="info-list">
          <li>
            <span class="label">聯絡窗口</span>
            <span>TTPA 秘書處 邱昶智 秘書長</span>
          </li>
          <li>
            <span class="label">聯絡電話</span>
            <a href="tel:0911095529">0911-095-529</a>
          </li>
          <li>
            <span class="label">電子信箱</span>
            <a href="mailto:ttpa2014@gmail.com">ttpa2014@gmail.com</a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .eyebrow {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    margin: 0;
  }

  h1 {
    color: var(--color-primary);
    margin-block: 0.25rem 2rem;
  }

  .card {
    max-width: 32rem;
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    box-shadow: var(--shadow-card);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .card h2 {
    color: var(--color-primary);
    margin-block: 0 1.25rem;
  }

  .info-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .info-list li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .label {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .info-list a {
    font-weight: 600;
  }
</style>
