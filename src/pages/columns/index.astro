---

<BaseLayout
  title="主題專欄 | 臺灣遠距藥事照護協會"
  description="臺灣遠距藥事照護協會主題專欄：藥事與健康相關文章與資訊之外部連結彙整。"
>
  <section class="hero">
    <div class="container">
      <h1>主題專欄</h1>
      <img class="header-image" src={headerImage} alt="" loading="lazy" width="640" height="200" />
    </div>
  </section>

  <section class="list">
    <div class="container">
      <ol class="article-list">
        {
          articles.map((a) => (
            <li class="article">
              {a.image && <img src={a.image} alt="" loading="lazy" width="320" height="200" />}
              {a.title && (a.link ? <a href={a.link}>{a.title}</a> : <span>{a.title}</span>)}
              {a.body && <p>{a.body}</p>}
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: var(--color-brand-soft);
    padding-block: clamp(2.5rem, 6vw, 4rem);
    text-align: center;
  }

  .hero h1 {
    color: var(--color-primary);
    margin: 0 0 1rem;
  }

  .header-image {
    max-width: 40rem;
    width: 100%;
    border-radius: 0.75rem;
  }

  .list {
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .article-list {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: article;
  }

  .article {
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    padding: 1.25rem;
    box-shadow: var(--shadow-card);
    counter-increment: article;
  }

  .article::before {
    content: counter(article) '. ';
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .article img {
    display: block;
    width: 100%;
    border-radius: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .article a {
    font-weight: 600;
  }

  .article p {
    margin: 0.5rem 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  @media (min-width: 768px) {
    .article-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
