---
// 理事長的話。內文逐字取自 .source/02-president.md，僅重新整理資訊層級與閱讀版面。
// 本文為 2017 年歷史文稿，職稱、計畫與時程均依當時內容保留。
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const photo = `${base}img/chairman-portrait.png`;

const paragraphs = [
  '臺灣遠距藥事照護協會（簡稱：TTPA）於今（104）年1月31日由各界醫藥及資訊先進共同組成，致力於國內各項遠距藥事照護作業的推廣及遠距系統的建置，已獲得產官學界的重大支持並有初步成果。',
  '孟基有幸承蒙各位先進愛戴，接任本會第二屆理事長，深感榮幸。日前我們已經在106年10月22日協同合作廠商完成「長照機構遠距藥事照護經驗分享研討會」藥師及護理師的持續教育專業職能訓練，並預計在107年正式啟動遠距藥事的職能認證作業。',
  '另一方面，也將配合國內藥事照護產業政策，並建置優質遠距藥局認證以及卓越藥局典範觀摩作業，讓民眾未來用藥能找到符合自己的專業照護藥師及合適的藥事及長照機構，確保民眾的用藥品質。',
  '最後在此敬祝各位先進，身心健康，順心如意。',
];
---

<BaseLayout
  title="理事長的話 | 臺灣遠距藥事照護協會 Taiwan Telepharmacy Association"
  description="讓民眾未來用藥能找到符合自己的專業照護藥師及合適的藥事及長照機構，確保民眾的用藥品質。"
>
  <main class="chairman-page">
    <header class="page-hero">
      <div class="hero-pattern" aria-hidden="true"></div>
      <div class="container hero-inner">
        <p class="eyebrow">MESSAGE FROM THE CHAIRMAN</p>
        <h1>理事長的話</h1>
        <span class="title-mark" aria-hidden="true"></span>
        <p class="hero-lede">從遠距藥事照護出發，讓科技成為專業服務與民眾用藥安全之間的橋梁。</p>
      </div>
    </header>

    <section class="message-section" aria-label="理事長歷史文稿">
      <div class="container message-wrap">
        <article class="message-card">
          <header class="profile">
            <div class="portrait-frame">
              <span aria-hidden="true"></span>
              <img src={photo} alt="劉孟基 理事長" width="532" height="714" />
            </div>

            <div class="profile-copy">
              <p class="profile-label">CHAIRMAN</p>
              <h2>劉孟基 藥師</h2>
              <p class="profile-role">臺灣遠距藥事照護協會 第二屆理事長</p>
              <blockquote>
                讓民眾未來用藥能找到符合自己的專業照護藥師及合適的藥事及長照機構，確保民眾的用藥品質。
              </blockquote>
            </div>
          </header>

          <div class="article-body">
            {paragraphs.map((paragraph, index) => (
              <p class:list={{ 'opening-paragraph': index === 0 }}>{paragraph}</p>
            ))}
          </div>

          <footer class="message-footer">
            <p class="publish-date">
              <span aria-hidden="true">◷</span>
              發布日期：2017/10/25
            </p>
            <div class="signature" aria-label="劉孟基理事長署名">
              <strong>劉孟基</strong>
              <span>理事長</span>
            </div>
          </footer>
        </article>

        <a class="back-link" href={base}><span aria-hidden="true">←</span> 返回首頁</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .chairman-page {
    background: var(--color-bg-light);
  }

  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-bottom: 1px solid var(--color-brand-tint);
    background: linear-gradient(145deg, var(--color-brand-soft), var(--color-white));
    text-align: center;
  }

  .hero-pattern {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--color-workshop-a10) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-workshop-a10) 1px, transparent 1px);
    background-size: 3rem 3rem;
    mask-image: linear-gradient(to bottom, var(--color-primary-dark), transparent 88%);
    opacity: 0.45;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
  }

  .eyebrow,
  .profile-label {
    margin: 0;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  h1 {
    margin: 0.35rem 0 0;
    color: var(--color-primary-dark);
    font-size: var(--text-3xl);
  }

  .title-mark {
    width: 4rem;
    height: 0.25rem;
    margin-block: 1.25rem;
    border-radius: 999rem;
    background: var(--color-accent);
  }

  .hero-lede {
    max-width: 44rem;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-base);
  }

  .message-section {
    padding-block: clamp(2rem, 6vw, 5rem);
  }

  .message-wrap {
    max-width: 64rem;
  }

  .message-card {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 1.75rem;
    background: var(--color-white);
    box-shadow: var(--shadow-card-hover);
  }

  .profile {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--color-line);
    background: linear-gradient(145deg, var(--color-white), var(--color-brand-soft));
  }

  .portrait-frame {
    position: relative;
    width: min(14rem, 70vw);
    aspect-ratio: 1;
    margin-inline: auto;
  }

  .portrait-frame span {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-brand-tint);
    transform: translate(0.55rem, 0.55rem);
  }

  .portrait-frame img {
    position: relative;
    width: 100%;
    height: 100%;
    border: 0.45rem solid var(--color-white);
    border-radius: 50%;
    object-fit: cover;
    object-position: center 18%;
    box-shadow: var(--shadow-card);
  }

  .profile-copy {
    text-align: center;
  }

  .profile h2 {
    margin: 0.35rem 0 0;
    color: var(--color-primary-dark);
    font-size: var(--text-2xl);
  }

  .profile-role {
    margin: 0.3rem 0 1.25rem;
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  blockquote {
    position: relative;
    max-width: 40rem;
    margin: 0;
    padding: 1.2rem 1.25rem 1.2rem 1.5rem;
    border-inline-start: 0.3rem solid var(--color-accent);
    border-radius: 0 0.8rem 0.8rem 0;
    background: var(--color-white);
    color: var(--color-primary-dark);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.7;
    text-align: start;
  }

  .article-body {
    max-width: 50rem;
    margin-inline: auto;
    padding: clamp(1.75rem, 5vw, 3.5rem);
  }

  .article-body p {
    margin: 0 0 1.45rem;
    color: var(--color-text);
    line-height: 2;
    text-align: justify;
  }

  .article-body p:last-child {
    margin-bottom: 0;
  }

  .opening-paragraph::first-letter {
    color: var(--color-accent);
    font-size: var(--text-2xl);
    font-weight: 800;
    line-height: 1;
  }

  .message-footer {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem clamp(1.75rem, 5vw, 3.5rem);
    border-top: 1px solid var(--color-line);
    background: var(--color-brand-soft);
  }

  .publish-date {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-xs);
  }

  .publish-date span {
    color: var(--color-accent);
  }

  .signature {
    display: grid;
    justify-items: end;
    color: var(--color-primary-dark);
  }

  .signature strong {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
  }

  .signature span {
    color: var(--color-ink-soft);
    font-size: var(--text-xs);
  }

  .back-link {
    display: flex;
    width: fit-content;
    gap: 0.55rem;
    align-items: center;
    margin: 1.75rem auto 0;
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--color-accent);
  }

  @media (min-width: 768px) {
    .profile {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .profile-copy {
      text-align: start;
    }

    .message-footer {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
