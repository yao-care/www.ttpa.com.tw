---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const results = (await getCollection('results')).sort((a, b) => {
  const aTime = a.data.date?.getTime() ?? 0;
  const bTime = b.data.date?.getTime() ?? 0;
  return bTime - aTime;
});

const featuredWorkshop = results.find((item) => item.id === 'nationwide-medical-ai-workshops');
const otherResults = results.filter((item) => item.id !== 'nationwide-medical-ai-workshops');

const pillars = [
  {
    number: '01',
    title: '專業教育賦能',
    body: '把新工具、新知識轉化成醫療人員能實際操作、帶回工作現場的方法。',
  },
  {
    number: '02',
    title: '場域合作共創',
    body: '依醫院、藥局與專業社群的真實需求，設計課程、研討會與客製專班。',
  },
  {
    number: '03',
    title: '醫藥科技媒合',
    body: '串連第一線需求與技術團隊，從痛點盤點、方案對話逐步走向實務驗證。',
  },
];

const impactFacts = [
  { value: '全台多場', label: '走入醫院、公會與專業研習場域' },
  { value: '100+', label: '累計完成上百位學員培訓' },
  { value: '跨五類角色', label: '醫、藥、護、醫事與行政共同學習' },
];

---

<BaseLayout
  title="活動成果｜臺灣遠距藥事照護協會"
  description="從專業培訓、醫療場域合作到醫藥科技媒合，看見臺灣遠距藥事照護協會如何把專業轉化為可持續的行動。"
>
  <main>
    <header class="results-hero">
      <div class="hero-media" aria-hidden="true">
        <img src={`${base}img/gallery-professional-exchange.jpg`} alt="" width="1600" height="900" />
      </div>
      <div class="hero-scrim" aria-hidden="true"></div>
      <div class="container hero-inner">
        <p class="eyebrow">TTPA IMPACT</p>
        <h1>專業不是口號，<br />是一場場落地的行動</h1>
        <p class="hero-lede">
          從醫療教育、跨專業交流到科技媒合，我們把第一線需求帶進課程與合作，
          也把可行的方法帶回照護現場。
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#featured-results">探索活動成果 <span aria-hidden="true">↓</span></a>
          <a class="button button-ghost" href={`${base}contact/`}>洽談合作 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </header>

    <section class="proof-section" aria-label="協會培訓成果摘要">
      <div class="container proof-grid">
        {
          impactFacts.map((fact) => (
            <div>
              <strong>{fact.value}</strong>
              <span>{fact.label}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="impact-intro" aria-labelledby="impact-title">
      <div class="container intro-layout">
        <div class="intro-heading">
          <p class="eyebrow">WHAT WE CREATE</p>
          <h2 id="impact-title">讓每一次活動，成為下一次合作的起點</h2>
        </div>
        <p class="intro-copy">
          活動成果不只是照片紀錄。我們整理每場活動解決的問題、串連的夥伴與延伸價值，
          讓醫療院所、專業社群與科技團隊能快速理解協會的實務能力。
        </p>
      </div>
      <div class="container pillar-grid">
        {
          pillars.map((pillar) => (
            <article class="pillar-card">
              <span>{pillar.number}</span>
              <h3>{pillar.title}</h3>
              <p>{pillar.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    {
      featuredWorkshop && (
        <section class="featured-section" id="featured-results" aria-labelledby="featured-title">
          <div class="container">
            <div class="section-heading">
              <div>
                <p class="eyebrow">FEATURED IMPACT</p>
                <h2 id="featured-title">從一場實作，擴散成全台培訓行動</h2>
              </div>
              <p>用真實現場紀錄，看見協會如何把數位工具轉化為醫療人員帶得走、用得上的能力。</p>
            </div>

            <article class="featured-story">
              <div class="featured-photos" aria-label="全台工作坊活動紀錄">
                {featuredWorkshop.data.gallery.slice(0, 3).map((photo, index) => (
                  <figure class:list={{ 'featured-photo-main': index === 0 }}>
                    <img src={`${base}${photo.src}`} alt={photo.alt} width="960" height="640" />
                    <figcaption>{photo.caption}</figcaption>
                  </figure>
                ))}
              </div>

              <div class="featured-content">
                <div class="card-meta">
                  <span class={`stage stage-${featuredWorkshop.data.stage}`}>{featuredWorkshop.data.stageLabel}</span>
                  <span>{featuredWorkshop.data.dateLabel}</span>
                </div>
                <p class="featured-kicker">{featuredWorkshop.data.eyebrow}</p>
                <h3>{featuredWorkshop.data.title}</h3>
                <p>{featuredWorkshop.data.summary}</p>
                <ul class="featured-highlights">
                  {featuredWorkshop.data.highlights.slice(0, 3).map((highlight) => <li>{highlight}</li>)}
                </ul>
                <a class="text-link" href={`${base}results/${featuredWorkshop.id}/`}>
                  閱讀全台培訓成果 <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          </div>
        </section>
      )
    }

    <section class="results-section" aria-labelledby="results-title">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">SELECTED OUTCOMES</p>
            <h2 id="results-title">合作、交流與媒合成果</h2>
          </div>
          <p>每項成果都以活動現場照片、合作脈絡與協會角色呈現，不再使用抽象情境圖。</p>
        </div>

        <div class="result-grid">
          {
            otherResults.map((item) => (
              <a class="result-card" href={`${base}results/${item.id}/`}>
                <div class="result-image">
                  <img src={`${base}${item.data.image}`} alt={item.data.imageAlt} loading="lazy" width="960" height="640" />
                </div>
                <div class="result-body">
                  <div class="card-meta">
                    <span class={`stage stage-${item.data.stage}`}>{item.data.stageLabel}</span>
                    <span>{item.data.dateLabel}</span>
                  </div>
                  <p class="result-category">{item.data.category}</p>
                  <h3>{item.data.title}</h3>
                  <p>{item.data.summary}</p>
                  <div class="result-contribution">
                    <strong>協會角色</strong>
                    <span>{item.data.contribution}</span>
                  </div>
                  <span class="text-link">閱讀成果故事 <span aria-hidden="true">→</span></span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="collaboration-cta" aria-labelledby="collaboration-title">
      <div class="container cta-inner">
        <div>
          <p class="eyebrow">BUILD WITH TTPA</p>
          <h2 id="collaboration-title">有一個醫療現場的問題，想一起解決？</h2>
          <p>歡迎醫療院所、藥局、學校、專業組織與科技團隊，和我們討論客製培訓、活動協作或技術媒合。</p>
        </div>
        <a class="button button-primary" href={`${base}contact/`}>提出合作構想 <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .results-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: min(49rem, 86vh);
    align-items: end;
    overflow: hidden;
    background: var(--color-primary-dark);
  }

  .hero-media,
  .hero-scrim,
  .hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-media {
    z-index: -3;
  }

  .hero-media img {
    object-fit: cover;
    object-position: center 42%;
  }

  .hero-scrim {
    z-index: -2;
    background: linear-gradient(90deg, var(--color-primary-a80), var(--scrim-20));
  }

  .hero-inner {
    width: 100%;
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .results-hero .eyebrow {
    color: var(--color-brand-tint);
  }

  .results-hero h1 {
    max-width: 54rem;
    margin: 0;
    color: var(--color-white);
    font-size: var(--text-3xl);
    text-shadow: var(--shadow-text);
  }

  .hero-lede {
    max-width: 48rem;
    margin: 1.25rem 0 0;
    color: var(--color-white);
    font-size: var(--text-lg);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .button {
    display: inline-flex;
    min-height: 3.5rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    border: 1px solid transparent;
    border-radius: 999rem;
    font-weight: 800;
    text-decoration: none;
  }

  .button-primary {
    background: var(--color-accent);
    color: var(--color-white);
  }

  .button-primary:hover {
    background: var(--color-accent-dark);
    color: var(--color-white);
  }

  .button-ghost {
    border-color: var(--color-white-a20);
    background: var(--color-white-a10);
    color: var(--color-white);
  }

  .button-ghost:hover {
    background: var(--color-white-a20);
    color: var(--color-white);
  }

  .impact-intro,
  .results-section,
  .featured-section,
  .collaboration-cta {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .proof-section {
    background: var(--color-primary-dark);
    color: var(--color-white);
  }

  .proof-grid {
    display: grid;
    padding-block: 1.25rem;
  }

  .proof-grid > div {
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--color-white-a20);
  }

  .proof-grid > div:last-child {
    border-bottom: 0;
  }

  .proof-grid strong,
  .proof-grid span {
    display: block;
  }

  .proof-grid strong {
    color: var(--color-white);
    font-size: var(--text-xl);
  }

  .proof-grid span {
    margin-top: 0.2rem;
    color: var(--color-brand-tint);
    font-size: var(--text-xs);
  }

  .intro-layout,
  .section-heading,
  .cta-inner {
    display: grid;
    gap: 1.25rem;
  }

  .intro-heading h2,
  .section-heading h2,
  .cta-inner h2 {
    margin: 0;
  }

  .intro-copy,
  .section-heading > p,
  .cta-inner p {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .pillar-grid {
    display: grid;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .pillar-card {
    padding: 1.5rem;
    border-top: 0.25rem solid var(--color-brand);
    border-radius: 0 0 1.25rem 1.25rem;
    background: var(--color-brand-soft);
  }

  .pillar-card > span {
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 800;
  }

  .pillar-card h3 {
    margin: 1rem 0 0.4rem;
    color: var(--color-primary-dark);
  }

  .pillar-card p {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .featured-section,
  .results-section {
    background: var(--color-bg-light);
  }

  .featured-section {
    border-top: 1px solid var(--color-line);
  }

  .section-heading {
    align-items: end;
    margin-bottom: 2rem;
  }

  .result-grid {
    display: grid;
    gap: 1.25rem;
  }

  .featured-story,
  .result-card {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 1.5rem;
    background: var(--color-white);
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    text-decoration: none;
  }

  .result-card:hover {
    color: var(--color-text);
  }

  .featured-photos img,
  .result-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-story {
    display: grid;
  }

  .featured-photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem;
    padding: 0.35rem;
    background: var(--color-white);
  }

  .featured-photos figure {
    position: relative;
    min-height: 13rem;
    margin: 0;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--color-brand-soft);
  }

  .featured-photo-main {
    grid-column: 1 / -1;
    min-height: 20rem;
  }

  .featured-photos figcaption {
    position: absolute;
    inset: auto 0 0;
    padding: 2.5rem 1rem 0.8rem;
    background: linear-gradient(0deg, var(--color-primary-a80), var(--scrim-0));
    color: var(--color-white);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .featured-content,
  .result-body {
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .featured-kicker,
  .result-category {
    margin: 0.75rem 0 0;
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .featured-content h3 {
    margin: 0.35rem 0 0.75rem;
    color: var(--color-primary-dark);
    font-size: var(--text-xl);
  }

  .featured-content > p:not(.featured-kicker) {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .featured-highlights {
    display: grid;
    gap: 0.45rem;
    margin: 1.25rem 0 0;
    padding-inline-start: 1.5rem;
    color: var(--color-primary-dark);
    font-weight: 700;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .stage {
    color: var(--color-primary);
  }

  .stage-ongoing,
  .stage-upcoming {
    color: var(--color-accent);
  }

  .result-body h3 {
    margin: 0.35rem 0 0.5rem;
    color: var(--color-primary-dark);
  }

  .result-body > p:not(.result-category) {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .result-contribution {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
  }

  .result-contribution strong,
  .result-contribution span {
    display: block;
  }

  .result-contribution strong {
    color: var(--color-primary-dark);
    font-size: var(--text-xs);
  }

  .result-contribution span {
    margin-top: 0.3rem;
    color: var(--color-ink-soft);
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  .text-link {
    display: inline-flex;
    gap: 0.4rem;
    margin-top: 1rem;
    color: var(--color-accent);
    font-weight: 800;
  }

  .result-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-brand-soft);
  }

  .collaboration-cta {
    background: var(--color-brand-soft);
  }

  .cta-inner {
    align-items: center;
  }

  @media (min-width: 768px) {
    .proof-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .proof-grid > div {
      padding: 0.5rem 1.5rem;
      border-right: 1px solid var(--color-white-a20);
      border-bottom: 0;
    }

    .proof-grid > div:first-child {
      padding-inline-start: 0;
    }

    .proof-grid > div:last-child {
      padding-inline-end: 0;
      border-right: 0;
    }

    .intro-layout,
    .section-heading,
    .cta-inner {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    }

    .pillar-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .featured-story {
      grid-template-columns: minmax(0, 1.35fr) minmax(20rem, 0.8fr);
    }

    .result-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .cta-inner .button {
      justify-self: end;
    }
  }

  @media (min-width: 1024px) {
    .featured-photos {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.8fr);
      grid-template-rows: repeat(2, minmax(0, 1fr));
    }

    .featured-photo-main {
      grid-column: auto;
      grid-row: 1 / -1;
      min-height: 34rem;
    }
  }
</style>
