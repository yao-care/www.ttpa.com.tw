// 2026-07-28 獨立驗收（.source/_final-audit.md P0-2／P1）指出：
//   (a) 115.03.21&22 高雄場（第四梯次，20-events-index.md:75-134）先前整場漏抓，已補回；
//   (b) 原 6 則舊公告的報名連結全數被砍、第 5 則(112.08.19)講師簡介被壓縮成「姓名/職稱」——
//       已比照原文逐字補回，不得摘要。
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// events 集合的 image 欄位：已下載自託管者存相對路徑（如 "img/xxx.jpg"，見
// public/img/ 與 2026-07-28 圖片自託管改動），仍是外連網址者（少數下載失敗保留）維持原樣。
const imageSrc = (path?: string) =>
  path ? (/^https?:\/\//.test(path) ? path : `${base}${path}`) : undefined;

const allEvents = await getCollection('events');
// 依原站導覽列順序排列（.source/20-events-index.md 導覽列列出順序）
const order = [
  'ai-pharma-tech-matching',
  'ai-workshop-taichung-tzuchi',
  'yuanrung-hospital-seminar',
  'asia-university-hospital',
];
const events = order
  .map((slug) => allEvents.find((e) => e.id === slug))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));
---

