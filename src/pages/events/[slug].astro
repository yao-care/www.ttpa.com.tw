---
// 活動詳情頁（動態路由）。以沉浸式 Hero、重點資訊卡、行動按鈕與雙欄內容提升閱讀層級。
// 不使用外部 CSS、字型、圖示或動畫套件；圖片一律使用 public/img/ 內的自託管資源。
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import AiPharmaPlatformPage from '../../components/AiPharmaPlatformPage.astro';
import TzuchiWorkshopPage from '../../components/TzuchiWorkshopPage.astro';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const {
  title,
  subtitle,
  dateLabel,
  location,
  status,
  summary,
  registrationLink,
  registrationNote,
  contactName,
  contactPhone,
  contactEmail,
  image,
} = event.data;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const imageSrc = image ? (/^https?:\/\//.test(image) ? image : `${base}${image}`) : undefined;
const isAiPlatform = event.id === 'ai-pharma-tech-matching';
const isTzuchiWorkshop = event.id === 'ai-workshop-taichung-tzuchi';
---

{
  isAiPlatform ? (
    <AiPharmaPlatformPage event={event} />
  ) : isTzuchiWorkshop ? (
    <TzuchiWorkshopPage event={event} />
  ) : (
<BaseLayout title={`${title}｜活動報名專區｜臺灣遠距藥事照護協會`} description={summary}>
  <header class="event-hero">
    {imageSrc && <img class="event-hero-image" src={imageSrc} alt="" width="1600" height="900" />}
    <div class="event-hero-overlay" aria-hidden="true"></div>

    <div class="container event-hero-inner">
      <a class="back-link" href={`${base}events/`}>← 返回活動報名專區</a>
      <div class="event-kicker">
        <span>需求與實務的連結</span>
        <StatusBadge status={status} />
      </div>
      <h1>{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
      <p class="summary">{summary}</p>

      <div class="hero-facts" aria-label="活動資訊">
        <div class="hero-fact">
          <span class="fact-icon" aria-hidden="true">◷</span>
          <span>
            <strong>活動日期</strong>
            <small>{dateLabel}</small>
          </span>
        </div>
        {
          location && (
            <div class="hero-fact">
              <span class="fact-icon" aria-hidden="true">◉</span>
              <span>
                <strong>活動地點</strong>
                <small>{location}</small>
              </span>
            </div>
          )
        }
      </div>

      <div class="hero-actions">
        {
          registrationLink ? (
            <a class="btn btn-primary" href={registrationLink} target="_blank" rel="noopener noreferrer">
              立即線上報名 <span aria-hidden="true">→</span>
            </a>
          ) : (
            <span class="registration-note">{registrationNote ?? '報名請洽下方聯繫窗口'}</span>
          )
        }
        <a class="btn btn-secondary" href="#event-content">查看完整活動內容</a>
      </div>
    </div>
  </header>

  {
    isAiPlatform && (
      <section class="series-section" aria-labelledby="series-title">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">AI SMART PHARMACY SERIES</p>
            <h2 id="series-title">AI 智慧社區藥局經營轉型系列活動</h2>
            <p>從需求媒合、系統落地到進階應用，循序建立實用的數位轉型能力。</p>
          </div>

          <div class="announcement">
            <span class="announcement-mark" aria-hidden="true">!</span>
            <p><strong>延期通知</strong>因颱風影響，二部曲順延至 8 月 22 日（六）；報名截止日為 8 月 17 日。</p>
          </div>

          <div class="organizer-grid" aria-label="活動主協辦單位">
            <article>
              <span>主辦單位</span>
              <h3>推動智慧照護</h3>
              <ul>
                <li>臺灣遠距藥事照護協會</li>
                <li>社團法人臺灣社區藥學會</li>
              </ul>
            </article>
            <article>
              <span>協辦單位</span>
              <h3>跨界實務聯手</h3>
              <ul>
                <li>員生醫院</li>
                <li>中山醫學大學附設醫院</li>
                <li>CNUP 全國藥學領袖人才培訓社</li>
              </ul>
            </article>
          </div>

          <div class="phase-grid">
            <article class="phase-card phase-complete">
              <span class="phase-label">首部曲 Phase 1</span>
              <span class="phase-symbol" aria-hidden="true">✓</span>
              <h3>痛點媒合與系統落地</h3>
              <p class="phase-meta">已圓滿結束｜6 月 6 日</p>
              <p>上午進行產業痛點與技術媒合，下午由原廠帶領實務操作 AI 藥事與經營管理系統。</p>
              <small>員榮醫院員生院區</small>
            </article>

            <div class="phase-arrow" aria-hidden="true">→</div>

            <article class="phase-card phase-active">
              <span class="phase-label">二部曲 Phase 2</span>
              <span class="phase-symbol" aria-hidden="true">↗</span>
              <h3>社區藥局智慧營運與科技輔具應用</h3>
              <p class="phase-meta">熱烈報名中｜8 月 22 日（六）</p>
              <p>現場實作 AI 工具與科技輔具，並參訪醫院藥劑科，掌握第一線數位藥事應用。</p>
              <small>中山醫學大學附設醫院</small>
              {registrationLink && (
                <a href={registrationLink} target="_blank" rel="noopener noreferrer">預留二部曲席次 →</a>
              )}
            </article>
          </div>
        </div>
      </section>
    )
  }

  <section class="event-content" id="event-content">
    <div class="container content-layout">
      <main class="prose-panel">
        <div class="prose">
          <Content />
        </div>
      </main>

      <aside class="event-aside" aria-label="活動報名與聯絡資訊">
        <div class="aside-card">
          <p class="aside-kicker">活動資訊</p>
          <h2>{title}</h2>
          <dl>
            <div>
              <dt>日期</dt>
              <dd>{dateLabel}</dd>
            </div>
            {
              location && (
                <div>
                  <dt>地點</dt>
                  <dd>{location}</dd>
                </div>
              )
            }
            {
              (contactName || contactPhone || contactEmail) && (
                <div>
                  <dt>聯絡窗口</dt>
                  <dd>
                    {contactName && <span>{contactName}</span>}
                    {contactPhone && <a href={`tel:${contactPhone.replace(/[^0-9+]/g, '')}`}>{contactPhone}</a>}
                    {contactEmail && <a href={`mailto:${contactEmail}`}>{contactEmail}</a>}
                  </dd>
                </div>
              )
            }
          </dl>
          {
            registrationLink ? (
              <a class="aside-cta" href={registrationLink} target="_blank" rel="noopener noreferrer">
                前往報名 <span aria-hidden="true">→</span>
              </a>
            ) : (
              <p class="aside-note">{registrationNote ?? '報名請洽聯繫窗口'}</p>
            )
          }
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
  )
}

<style>
  .event-hero {
    position: relative;
    isolation: isolate;
    min-height: min(50rem, 88vh);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--color-primary-dark);
  }

  .event-hero-image,
  .event-hero-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .event-hero-image {
    z-index: -3;
    object-fit: cover;
  }

  .event-hero-overlay {
    z-index: -2;
    background: linear-gradient(135deg, var(--scrim-50), var(--color-primary-a80));
  }

  .event-hero-inner {
    width: 100%;
    padding-block: clamp(3rem, 9vw, 7rem);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    margin-bottom: 2rem;
    color: var(--color-white);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-brand-tint);
  }

  .event-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .event-kicker > span:first-child {
    padding: 0.35rem 1rem;
    border: 1px solid var(--color-white-a20);
    border-radius: 999rem;
    background: var(--color-white-a10);
    color: var(--color-white);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .event-hero h1 {
    max-width: 58rem;
    margin: 0;
    color: var(--color-white);
    font-size: var(--text-3xl);
    text-shadow: var(--shadow-text);
  }

  .subtitle {
    margin: 0.75rem 0 0;
    color: var(--color-brand-tint);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .summary {
    max-width: 52rem;
    margin: 1.25rem 0 2rem;
    color: var(--color-white);
    font-size: var(--text-lg);
  }

  .hero-facts {
    display: grid;
    gap: 0.75rem;
    max-width: 58rem;
    padding: 1rem;
    border: 1px solid var(--color-white-a20);
    border-radius: 1.25rem;
    background: var(--color-white-a10);
    box-shadow: var(--shadow-float);
  }

  .hero-fact {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.5rem;
    color: var(--color-white);
  }

  .fact-icon {
    flex: 0 0 auto;
    color: var(--color-brand-tint);
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  .hero-fact strong,
  .hero-fact small {
    display: block;
  }

  .hero-fact small {
    margin-top: 0.15rem;
    color: var(--color-white);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.5rem;
    padding: 0.75rem 1.5rem;
    border: 1px solid transparent;
    border-radius: 999rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-0.125rem);
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-white);
    box-shadow: var(--shadow-float);
  }

  .btn-primary:hover {
    background: var(--color-accent-dark);
    color: var(--color-white);
  }

  .btn-secondary {
    border-color: var(--color-white-a20);
    background: var(--color-white-a10);
    color: var(--color-white);
  }

  .btn-secondary:hover {
    background: var(--color-white-a20);
    color: var(--color-white);
  }

  .registration-note {
    color: var(--color-white);
  }

  .series-section {
    padding-block: clamp(3rem, 8vw, 6rem);
    background: var(--color-bg-light);
  }

  .section-heading {
    max-width: 54rem;
    margin: 0 auto 2rem;
    text-align: center;
  }

  .section-heading h2 {
    margin: 0.25rem 0 0.75rem;
    color: var(--color-primary-dark);
  }

  .section-heading > p:last-child {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .eyebrow,
  .aside-kicker {
    margin: 0;
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .announcement {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    max-width: 58rem;
    margin: 0 auto 2.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-brand);
    border-radius: 1rem;
    background: var(--color-brand-soft);
    color: var(--color-primary-dark);
  }

  .announcement p {
    margin: 0;
  }

  .announcement strong {
    display: block;
  }

  .announcement-mark {
    display: inline-grid;
    flex: 0 0 2.25rem;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-white);
    font-weight: 800;
  }

  .phase-grid {
    display: grid;
    gap: 1.25rem;
    align-items: stretch;
    max-width: 64rem;
    margin-inline: auto;
  }

  .organizer-grid {
    display: grid;
    gap: 1rem;
    max-width: 64rem;
    margin: 0 auto 3rem;
  }

  .organizer-grid article {
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    background: var(--color-white);
    box-shadow: var(--shadow-card);
  }

  .organizer-grid article > span {
    display: inline-block;
    padding: 0.2rem 0.75rem;
    border-radius: 999rem;
    background: var(--color-brand-soft);
    color: var(--color-primary-dark);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .organizer-grid h3 {
    margin: 0.75rem 0 0.5rem;
    color: var(--color-primary-dark);
  }

  .organizer-grid ul {
    margin: 0;
    padding-inline-start: 1.5rem;
    color: var(--color-ink-soft);
  }

  .phase-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border: 1px solid var(--color-line);
    border-radius: 1.5rem;
    background: var(--color-white);
    box-shadow: var(--shadow-card);
  }

  .phase-card h3 {
    margin: 1rem 0 0.5rem;
    color: var(--color-primary-dark);
  }

  .phase-card p {
    color: var(--color-ink-soft);
  }

  .phase-card small {
    display: block;
    margin-top: auto;
    color: var(--color-ink-muted);
  }

  .phase-active {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-card-hover);
  }

  .phase-label {
    align-self: flex-start;
    padding: 0.25rem 0.85rem;
    border-radius: 999rem;
    background: var(--color-brand-soft);
    color: var(--color-primary-dark);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .phase-active .phase-label {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .phase-symbol {
    display: inline-grid;
    width: 3.5rem;
    height: 3.5rem;
    margin-top: 1.25rem;
    place-items: center;
    border-radius: 50%;
    background: var(--color-bg-light);
    color: var(--color-primary);
    font-size: var(--text-xl);
    font-weight: 800;
  }

  .phase-active .phase-symbol {
    background: var(--color-brand-soft);
  }

  .phase-meta {
    color: var(--color-primary);
    font-weight: 700;
  }

  .phase-card > a {
    display: inline-flex;
    align-self: flex-start;
    margin-top: 1.25rem;
    font-weight: 700;
  }

  .phase-arrow {
    display: grid;
    place-items: center;
    color: var(--color-brand);
    font-size: var(--text-2xl);
    transform: rotate(90deg);
  }

  .event-content {
    padding-block: clamp(3rem, 8vw, 6rem);
    background: var(--color-white);
  }

  .content-layout {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .prose-panel,
  .aside-card {
    border: 1px solid var(--color-line);
    border-radius: 1.5rem;
    background: var(--color-white);
    box-shadow: var(--shadow-card);
  }

  .prose-panel {
    min-width: 0;
    padding: clamp(1.25rem, 4vw, 3rem);
  }

  .prose {
    max-width: 52rem;
  }

  .prose :global(h2) {
    margin: 3rem 0 1rem;
    padding-bottom: 0.65rem;
    border-bottom: 0.2rem solid var(--color-brand-tint);
    color: var(--color-primary-dark);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    margin: 2rem 0 0.75rem;
    color: var(--color-primary);
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--color-text);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: 1.5rem;
  }

  .prose :global(li + li) {
    margin-top: 0.5rem;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin-block: 1.5rem;
    display: block;
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    font-size: var(--text-sm);
  }

  .prose :global(th),
  .prose :global(td) {
    min-width: 9rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--color-line);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    background: var(--color-primary-dark);
    color: var(--color-white);
  }

  .prose :global(tr:last-child td) {
    border-bottom: 0;
  }

  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: 1.25rem;
    border-inline-start: 0.25rem solid var(--color-brand);
    border-radius: 0 1rem 1rem 0;
    background: var(--color-brand-soft);
    color: var(--color-primary-dark);
  }

  .prose :global(img) {
    border-radius: 1rem;
    box-shadow: var(--shadow-card);
  }

  .aside-card {
    padding: 1.5rem;
  }

  .aside-card h2 {
    margin: 0.25rem 0 1.25rem;
    color: var(--color-primary-dark);
    font-size: var(--text-lg);
  }

  .aside-card dl {
    margin: 0;
  }

  .aside-card dl > div {
    padding-block: 0.85rem;
    border-top: 1px solid var(--color-line);
  }

  .aside-card dt {
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .aside-card dd {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: 0.2rem 0 0;
    color: var(--color-text);
  }

  .aside-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0.85rem 1rem;
    border-radius: 999rem;
    background: var(--color-accent);
    color: var(--color-white);
    font-weight: 700;
    text-decoration: none;
  }

  .aside-cta:hover {
    background: var(--color-accent-dark);
    color: var(--color-white);
  }

  .aside-note {
    margin: 1rem 0 0;
    color: var(--color-ink-soft);
  }

  @media (min-width: 768px) {
    .hero-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .phase-grid {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    }

    .organizer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .phase-arrow {
      transform: none;
    }
  }

  @media (min-width: 1024px) {
    .content-layout {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }

    .event-aside {
      position: sticky;
      top: 6.5rem;
    }
  }
</style>
