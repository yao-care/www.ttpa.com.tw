---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const instructors = await getCollection('instructors');
  return instructors.map((instructor) => ({
    params: { slug: instructor.id },
    props: { instructor },
  }));
}

const { instructor } = Astro.props;
const { Content } = await render(instructor);
const { name, role, photo, photoAlt, specialties, summary, credentials, taughtCourses } = instructor.data;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title={`${name}｜講師群｜臺灣遠距藥事照護協會`}
  description={`${name}講師的專長、專業資歷與 TTPA 授課紀錄。${summary}`}
>
  <main class="instructor-page">
    <section class="profile-hero">
      <div class="container profile-grid">
        <div class="profile-photo-wrap">
          <div class="profile-photo">
            <img src={`${base}${photo}`} alt={photoAlt} width="900" height="900" />
          </div>
          <span class="photo-label">TTPA 專業講師</span>
        </div>

        <div class="profile-copy">
          <a class="back-link" href={`${base}links/#faculty`}>← 返回講師群</a>
          <p class="eyebrow">FACULTY PROFILE</p>
          <h1>{name}</h1>
          <p class="role">{role}</p>
          <p class="summary">{summary}</p>
          <ul class="specialty-list" aria-label={`${name}專長`}>
            {specialties.map((specialty) => <li>{specialty}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="profile-detail" aria-labelledby="profile-title">
      <div class="container detail-grid">
        <aside class="credential-card" aria-labelledby="credentials-title">
          <span class="aside-label">PROFESSIONAL BACKGROUND</span>
          <h2 id="credentials-title">專業資歷</h2>
          {
            credentials.length > 0 ? (
              <ul>
                {credentials.map((credential) => <li>{credential}</li>)}
              </ul>
            ) : (
              <p>詳細資歷整理中。</p>
            )
          }
          <a href={`${base}contact/`}>邀課與合作洽詢 <span aria-hidden="true">→</span></a>
        </aside>

        <article class="detail-main">
          <p class="eyebrow">ABOUT THE INSTRUCTOR</p>
          <h2 id="profile-title">講師介紹</h2>
          <div class="prose"><Content /></div>

          {
            taughtCourses.length > 0 && (
              <section class="courses" aria-labelledby="courses-title">
                <div class="section-heading">
                  <p class="eyebrow">COURSES &amp; SESSIONS</p>
                  <h2 id="courses-title">曾授課程</h2>
                  <p>點選有連結的項目，可查看該課程或活動的完整資訊。</p>
                </div>

                <div class="course-list">
                  {taughtCourses.map((course) => (
                    course.href ? (
                      <a class="course-card" href={`${base}${course.href}`}>
                        <div>
                          <span>{course.context}</span>
                          <h3>{course.title}</h3>
                        </div>
                        <span class="course-arrow" aria-hidden="true">→</span>
                      </a>
                    ) : (
                      <article class="course-card course-card-static">
                        <div>
                          <span>{course.context}</span>
                          <h3>{course.title}</h3>
                        </div>
                      </article>
                    )
                  ))}
                </div>
              </section>
            )
          }
        </article>
      </div>
    </section>

    <section class="next-step" aria-labelledby="next-title">
      <div class="container next-inner">
        <div>
          <p class="eyebrow">EXPLORE MORE</p>
          <h2 id="next-title">繼續探索專業學習內容</h2>
          <p>查看協會目前的線上課程、活動與專業交流資訊。</p>
        </div>
        <div class="next-actions">
          <a class="button button-light" href={`${base}courses/`}>線上課程</a>
          <a class="button button-outline" href={`${base}events/`}>活動報名</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .instructor-page {
    overflow: clip;
  }

  .profile-hero {
    padding-block: clamp(3rem, 8vw, 6.5rem);
    background: linear-gradient(145deg, var(--color-brand-soft), var(--color-white));
  }

  .profile-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .profile-photo-wrap {
    position: relative;
    max-width: 33rem;
    padding: 0.75rem;
  }

  .profile-photo {
    overflow: hidden;
    border: 0.65rem solid var(--color-white);
    border-radius: 2rem;
    background: var(--color-brand-tint);
    box-shadow: var(--shadow-card-hover);
  }

  .profile-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .photo-label {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--color-brand-tint);
    border-radius: 0.85rem;
    background: var(--color-white);
    color: var(--color-primary-dark);
    box-shadow: var(--shadow-card);
    font-size: var(--text-xs);
    font-weight: 800;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 1.25rem;
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
  }

  .eyebrow,
  .aside-label {
    margin: 0 0 0.65rem;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  .profile-copy h1 {
    margin: 0;
    color: var(--color-primary-dark);
    font-size: var(--text-3xl);
  }

  .role {
    margin: 0.65rem 0 0;
    color: var(--color-primary);
    font-size: var(--text-lg);
    font-weight: 800;
  }

  .summary {
    max-width: 46rem;
    margin: 1.25rem 0;
    color: var(--color-ink-soft);
    font-size: var(--text-lg);
  }

  .specialty-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .specialty-list li {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--color-brand-tint);
    border-radius: 999rem;
    background: var(--color-white);
    color: var(--color-primary-dark);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .profile-detail {
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .detail-grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .detail-main > h2,
  .section-heading h2,
  .credential-card h2,
  .next-step h2 {
    margin: 0;
    color: var(--color-primary-dark);
    font-size: var(--text-2xl);
  }

  .prose {
    margin-top: 1.25rem;
    color: var(--color-ink-soft);
    font-size: var(--text-base);
  }

  .prose :global(p) {
    margin-block: 0 1rem;
  }

  .credential-card {
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: 1px solid var(--color-brand-tint);
    border-radius: 1.5rem;
    background: var(--color-brand-soft);
  }

  .credential-card ul {
    display: grid;
    gap: 0.85rem;
    margin: 1.25rem 0;
    padding: 0;
    list-style: none;
  }

  .credential-card li {
    position: relative;
    padding-left: 1.7rem;
    color: var(--color-ink-soft);
  }

  .credential-card li::before {
    position: absolute;
    left: 0;
    color: var(--color-accent);
    content: '✓';
    font-weight: 900;
  }

  .credential-card > a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 800;
    text-decoration: none;
  }

  .courses {
    margin-top: 3.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-line);
  }

  .section-heading > p:last-child {
    margin: 0.75rem 0 0;
    color: var(--color-ink-soft);
  }

  .course-list {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .course-card {
    display: flex;
    min-height: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background: var(--color-white);
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    text-decoration: none;
  }

  a.course-card:hover,
  a.course-card:focus-visible {
    color: var(--color-text);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-card-hover);
  }

  .course-card span:first-child {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
  }

  .course-card h3 {
    margin: 0.25rem 0 0;
    color: var(--color-primary-dark);
    font-size: var(--text-lg);
  }

  .course-arrow {
    flex: 0 0 auto;
    color: var(--color-primary);
    font-size: var(--text-xl);
  }

  .course-card-static {
    box-shadow: none;
  }

  .next-step {
    padding-block: clamp(3rem, 7vw, 5rem);
    background: var(--color-primary-dark);
  }

  .next-inner {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .next-step .eyebrow {
    color: var(--color-brand-tint);
  }

  .next-step h2,
  .next-step p {
    color: var(--color-white);
  }

  .next-step p:last-child {
    margin: 0.75rem 0 0;
  }

  .next-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .button {
    display: inline-flex;
    min-height: 3.5rem;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.2rem;
    border: 1px solid var(--color-white);
    border-radius: 0.85rem;
    font-weight: 800;
    text-decoration: none;
  }

  .button-light {
    background: var(--color-white);
    color: var(--color-primary-dark);
  }

  .button-outline {
    background: transparent;
    color: var(--color-white);
  }

  .button-outline:hover,
  .button-outline:focus-visible {
    background: var(--color-white);
    color: var(--color-primary-dark);
  }

  @media (min-width: 768px) {
    .course-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .next-inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media (min-width: 1024px) {
    .profile-grid {
      grid-template-columns: minmax(19rem, 0.75fr) minmax(0, 1.25fr);
      gap: 4rem;
    }

    .detail-grid {
      grid-template-columns: minmax(20rem, 0.6fr) minmax(0, 1.4fr);
      gap: 4rem;
    }

    .credential-card {
      position: sticky;
      top: calc(var(--site-header-height) + 2rem);
    }
  }
</style>
