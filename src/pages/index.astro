---
// 首頁。內容逐字取自 .source/01-home.md（Hero／理事長的話／核心服務／活動花絮／合作團體／頁尾快速連結），
// 未增刪潤飾；圖片已於 2026-07-28 由原站外連網址（Google 圖庫服務／Unsplash）
// 下載自託管至 public/img/，此輪只動路徑不動文案。
// 頁尾快速導流卡片對應「首頁」在 .source/_ia-plan.md § 3 的 4 個子頁，非新創文案。
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const chairmanUrl = `${base}chairman/`;

// 理事長方針三小節，逐字取自 01-home.md:50-60
const visionPoints = [
  {
    title: '培育優質遠距醫療人才',
    body: '不僅是單一專業領域，更強調跨領域溝通與經營管理。協會將提供專業訓練，培養能與合作夥伴達成雙贏局面的全方位醫療人才。',
  },
  {
    title: '創新「照護門診」',
    body: '從居家到社區，透過定期訪視與科技輔助，進行「門前健診」。解決民眾健康上的疑難雜症，將傳統服務進化為專業諮詢。',
  },
  {
    title: '立足台灣，放眼國際',
    body: '首要工作是強化醫事人員專業知能，開發第二、三專長。不僅服務台灣民眾，更目標將合格的「遠距醫療」服務模式輸出國際。',
  },
];

// 核心服務四項，逐字取自 01-home.md:68-82
const services = [
  {
    title: '專業訓練與認證',
    body: '提供跨領域遠距醫療訓練課程，強化溝通、管理與科技應用能力，認證正式合格的「遠距醫療人員」。',
  },
  {
    title: '長照與機構整合照護',
    body: '針對長照機構住民或安養中心，提供涉及評鑑相關的專業照護服務，提升照護品質與機構評鑑成績。',
  },
  {
    title: '社區藥局系統開發平台',
    body: '協助軟體開發公司提供藥事上的專業合作。',
  },
  {
    title: '數位系統整合',
    body: '開發「慢性處方管理系統」及客製化行動服務，連結醫事人員與社區/機構，實現送藥到府與加值諮詢的一條龍服務。',
  },
];

// 活動花絮，逐字取自 01-home.md:90-97（原站為跑馬燈，此處以靜態網格呈現同一輪內容）
// 圖片已於 2026-07-28 由外連 Google/Unsplash 下載自託管至 public/img/（見該檔頭註解），
// 避免協會日後在 Google 端刪改導致正式站破圖；此輪只動 src 路徑，未增刪圖片或文案。
const gallery = [
  {
    src: `${base}img/gallery-dahan-seminar.jpg`,
    alt: '大仁科技大學國際研討會',
    caption: '114年 大仁科技大學國際研討會',
  },
  {
    src: `${base}img/gallery-ai-course.jpg`,
    alt: 'AI高校系列課程',
    caption: 'AI 高效系列課程',
  },
  {
    src: `${base}img/gallery-professional-exchange.jpg`,
    alt: '專業交流',
    caption: '醫事專業交流與培訓',
  },
  {
    src: `${base}img/gallery-training-certificate.jpg`,
    alt: '專業遠距培訓證書',
    caption: '專業遠距培訓證書',
  },
  {
    src: `${base}img/gallery-student-participation.jpg`,
    alt: '培養在學學生參與公眾活動',
    caption: '培養在學學生參與公眾活動',
  },
  {
    src: `${base}img/gallery-medtech.jpg`,
    alt: '醫療科技應用',
    caption: '醫療科技應用研討',
  },
  {
    src: `${base}img/gallery-highlights-1.png`,
    alt: '協會活動花絮',
    caption: '協會活動花絮',
  },
  {
    src: `${base}img/gallery-highlights-2.png`,
    alt: '協會活動花絮',
    caption: '協會活動花絮',
  },
];

// 合作團體，逐字取自 01-home.md:103-106
const partners = [
  {
    src: `${base}img/partner-yuanrung.png`,
    alt: '員榮醫療社團法人員榮醫院',
  },
  {
    src: `${base}img/partner-pharmacist-assoc.png`,
    alt: '社團法人臺灣社區藥學會',
  },
  {
    src: `${base}img/partner-pharma-foundation.png`,
    alt: '財團法人中華藥學研究基金會',
  },
  {
    src: `${base}img/partner-cnup.png`,
    alt: 'CNUP全國藥學領袖人才培訓社',
  },
];

// Hero 背景與理事長方針照片，同上輪自託管（原為 Unsplash／Google Drawings 外連）
const heroBgUrl = `${base}img/hero-bg.jpg`;
const chairmanVisionPhoto = `${base}img/chairman-vision.png`;

// 「首頁」子頁導流卡片，對應 .source/_ia-plan.md § 1 路由對照表第 2-5 列。
// description 逐字取自各子頁本身的英文副標（02-president.md:19、03-charter.md:19、
// 04-contact.md:19、05-org.md:19），非自創文案。
const homeSubpages = [
  { title: '理事長的話', href: `${base}chairman/`, description: 'Message from the Chairman' },
  { title: '協會章程', href: `${base}charter/`, description: 'Charter of the Association' },
  { title: '聯絡我們', href: `${base}contact/`, description: 'Contact Us' },
  { title: '組織架構與夥伴招募', href: `${base}join-us/`, description: 'Organization & Recruitment' },
];
---

<BaseLayout
  title="臺灣遠距藥事照護協會 Taiwan Telepharmacy Association"
  description="臺灣遠距藥事照護協會官方網站：結合科技與專業，打造優質遠距醫療團隊，提供從居家到機構的全方位照護服務。"
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="hero-badge">Professional Telemedicine</p>
      <h1>
        讓台灣醫療專業<br />
        無遠弗屆，守護健康
      </h1>
      <p class="hero-lede">
        結合科技與專業，打造優質遠距醫療團隊，提供從居家到機構的全方位照護服務。
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={chairmanUrl}>了解願景</a>
        <a class="btn btn-outline" href="#services">服務項目</a>
      </div>
    </div>
  </section>

  <section class="vision">
    <div class="container vision-inner">
      <img
        class="vision-photo"
        src={chairmanVisionPhoto}
        alt="劉孟基 理事長"
        width="480"
        height="360"
        loading="lazy"
      />
      <div class="vision-content">
        <p class="vision-tag">劉孟基<br />TTPA 理事長</p>
        <h2>理事長方針：打造遠距醫療競爭力</h2>
        <blockquote>
          「我們期待將『遠距醫療』的服務擴展到其他國家，讓台灣的醫療專業可以無遠弗屆。」
        </blockquote>
        {
          visionPoints.map((point) => (
            <div class="vision-point">
              <h3>{point.title}</h3>
              <p>{point.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="services" id="services">
    <div class="container">
      <h2>我們可以做的地方</h2>
      <p class="section-lede">針對市場需求，整合專業與科技，提供具競爭力的解決方案</p>
      <div class="services-grid">
        {
          services.map((service) => (
            <div class="service-card">
              <h3>{service.title}</h3>
              <p>{service.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="gallery">
    <div class="container">
      <h2>協會近期活動與成果</h2>
      <p class="section-lede">持續推動醫療教育與國際交流</p>
      <div class="gallery-grid">
        {
          gallery.map((item) => (
            <figure>
              <img src={item.src} alt={item.alt} loading="lazy" width="320" height="220" />
              <figcaption>{item.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="partners">
    <div class="container">
      <h2>合作團體</h2>
      <div class="partners-grid">
        {
          partners.map((partner) => (
            <img src={partner.src} alt={partner.alt} loading="lazy" width="200" height="150" />
          ))
        }
      </div>
    </div>
  </section>

  <section class="more">
    <div class="container">
      <h2>認識協會更多</h2>
      <div class="more-grid">
        {
          homeSubpages.map((page) => (
            <Card href={page.href} title={page.title} description={page.description} cta="前往閱讀" />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style define:vars={{ heroBgUrl: `url(${heroBgUrl})` }}>
  section {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  h2 {
    color: var(--color-primary);
    text-align: center;
    margin-block: 0 0.5rem;
  }

  .section-lede {
    text-align: center;
    color: var(--color-ink-soft);
    max-width: 40rem;
    margin: 0 auto clamp(1.5rem, 4vw, 2.5rem);
  }

  /* Hero */
  .hero {
    background: linear-gradient(var(--color-primary-a80), var(--color-primary-a60)),
      var(--heroBgUrl) center/cover no-repeat;
    color: var(--color-white);
    padding-block: clamp(3.5rem, 12vw, 7rem);
  }

  .hero-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.25rem 1rem;
    border-radius: 999px;
    background: var(--color-white-a20);
    font-size: var(--text-sm);
    margin: 0;
  }

  .hero h1 {
    margin: 0;
    color: var(--color-white);
    text-shadow: var(--shadow-text);
    font-size: var(--text-3xl);
  }

  .hero-lede {
    max-width: 40rem;
    font-size: var(--text-lg);
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-white);
  }

  .btn-primary:hover {
    background: var(--color-accent-dark);
    color: var(--color-white);
  }

  .btn-outline {
    border: 1px solid var(--color-white);
    color: var(--color-white);
  }

  .btn-outline:hover {
    background: var(--color-white-a20);
    color: var(--color-white);
  }

  /* Vision */
  .vision-inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .vision-photo {
    width: min(100%, 20rem);
    margin-inline: auto;
    border-radius: 0.75rem;
  }

  .vision-tag {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    margin: 0 0 0.5rem;
  }

  .vision-content h2 {
    text-align: left;
    margin-bottom: 1rem;
  }

  blockquote {
    margin: 0 0 1.5rem;
    padding-inline-start: 1rem;
    border-inline-start: 0.25rem solid var(--color-brand);
    color: var(--color-primary-dark);
    font-size: var(--text-lg);
  }

  .vision-point {
    margin-bottom: 1.25rem;
  }

  .vision-point h3 {
    color: var(--color-primary);
    margin-block: 0 0.25rem;
  }

  .vision-point p {
    margin: 0;
    color: var(--color-ink-soft);
  }

  /* Services */
  .services {
    background: var(--color-brand-soft);
  }

  .services-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  .service-card {
    background: var(--color-white);
    border-radius: 0.75rem;
    padding: 1.5rem;
    box-shadow: var(--shadow-card);
  }

  .service-card h3 {
    color: var(--color-primary);
    margin-block: 0 0.5rem;
  }

  .service-card p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  /* Gallery */
  .gallery-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, 1fr);
  }

  .gallery-grid figure {
    margin: 0;
  }

  .gallery-grid img {
    width: 100%;
    aspect-ratio: 16 / 11;
    object-fit: cover;
    border-radius: 0.5rem;
  }

  .gallery-grid figcaption {
    margin-top: 0.375rem;
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
    text-align: center;
  }

  /* Partners */
  .partners-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(2, 1fr);
    align-items: center;
    justify-items: center;
  }

  .partners-grid img {
    max-width: 10rem;
    height: auto;
  }

  /* More cards */
  .more-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .partners-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .more-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .vision-inner {
      flex-direction: row;
      align-items: flex-start;
    }

    .vision-photo {
      flex: 0 0 20rem;
      margin-inline: 0;
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .more-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
