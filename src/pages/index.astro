---
// 首頁。內容以 .source/01-home.md 為基礎，並經過官網文案可讀性校訂。
// 圖片已於 2026-07-28 由原站外連網址下載自託管至 public/img/。
// 頁尾快速導流卡片對應「首頁」在 .source/_ia-plan.md § 3 的 4 個子頁，非新創文案。
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const chairmanUrl = `${base}chairman/`;

// 協會三項核心目標，內容取自 01-home.md:50-60 的理事長方針。
// 首頁先以組織角度呈現，再於後段補充理事長願景。
const associationGoals = [
  {
    title: '培育優質遠距藥事人才',
    body: '不僅是單一專業領域，更強調跨領域溝通與經營管理。協會將提供專業訓練，培養能與合作夥伴達成雙贏局面的全方位醫療人才。',
  },
  {
    title: '創新「照護門診」',
    body: '從居家到社區，透過定期訪視與科技輔助，進行「線上用藥照護」，協助民眾釐清用藥與健康照護疑問，將傳統服務提升為專業諮詢。',
  },
  {
    title: '立足臺灣，放眼國際',
    body: '首要工作是強化醫事人員的專業知能，培養第二、第三專長。除了服務臺灣民眾，更以將合格的「遠距藥事」服務模式推向國際為目標。',
  },
];

// 核心服務四項，逐字取自 01-home.md:68-82
const services = [
  {
    title: '專業訓練與認證',
    body: '提供跨領域遠距藥事訓練課程，強化溝通、管理與科技應用能力，認證正式合格的「遠距藥事人員」。',
  },
  {
    title: '長照與機構整合照護',
    body: '針對長照機構住民與安養中心，提供與機構評鑑相關的專業照護服務，提升照品質與機構評鑑成績。',
  },
  {
    title: '社區藥局系統開發平台',
    body: '提供藥事專業顧問服務，協助軟體公司開發符合藥事實務需求的系統。',
  },
  {
    title: '數位系統整合',
    body: '開發「慢性病用藥管理及健康諮詢系統」與客製化行動服務，連結醫事人員、社區與機構，實現送藥到府與加值諮詢的整合服務。',
  },
];

// 首頁「近期實體活動與成果」直接連動 events 與 results 內容集合。
// 線上課程位於 courses 集合，不會進入此區。
const eventEntries = await getCollection('events');
const resultEntries = await getCollection('results');
const isClosedEvent = (status = '') => /(?:已結束|活動已結束|截止)/.test(status);
const featuredEvent = eventEntries
  .filter((event) => event.data.featured && !isClosedEvent(event.data.status))
  .sort((a, b) => (a.data.date?.getTime() ?? Number.MAX_SAFE_INTEGER) - (b.data.date?.getTime() ?? Number.MAX_SAFE_INTEGER))[0];
const recentResults = resultEntries
  .filter((result) => result.data.featured)
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .slice(0, featuredEvent ? 2 : 3);

const activityHighlights = [
  ...(featuredEvent
    ? [{
        kind: '近期實體活動',
        status: featuredEvent.data.status ?? '活動資訊',
        tone: 'open',
        title: featuredEvent.data.title,
        dateLabel: featuredEvent.data.dateLabel,
        summary: featuredEvent.data.summary,
        src: featuredEvent.data.image ? `${base}${featuredEvent.data.image}` : `${base}img/gallery-professional-exchange.jpg`,
        alt: featuredEvent.data.title,
        href: `${base}events/${featuredEvent.id}/`,
        cta: '查看活動詳情',
      }]
    : []),
  ...recentResults.map((result) => ({
    kind: result.data.category,
    status: result.data.stageLabel,
    tone: result.data.stage === 'ongoing' ? 'ongoing' : 'completed',
    title: result.data.title,
    dateLabel: result.data.dateLabel,
    summary: result.data.summary,
    src: `${base}${result.data.image}`,
    alt: result.data.imageAlt,
    href: `${base}results/${result.id}/`,
    cta: '閱讀成果故事',
  })),
];

// 直接連動合作夥伴內容集合；日後增修 src/content/partners/ 時，首頁會自動同步。
const partnerEntries = await getCollection('partners');
const partners = partnerEntries
  .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name, 'zh-Hant'))
  .map((partner) => ({
    name: partner.data.name,
    website: partner.data.website,
    src: `${base}${partner.data.logo}`,
    alt: partner.data.logoAlt,
  }));

// Hero 背景與理事長方針照片，同上輪自託管（原為 Unsplash／Google Drawings 外連）
const heroBgUrl = `${base}img/hero-bg.jpg`;
const chairmanVisionPhoto = `${base}img/chairman-vision.png`;

// 「首頁」子頁導流卡片，對應 .source/_ia-plan.md § 1 路由對照表第 2-5 列。
// description 逐字取自各子頁本身的英文副標（02-president.md:19、03-charter.md:19、
// 04-contact.md:19、05-org.md:19），非自創文案。
const homeSubpages = [
  { title: '理事長的話', href: `${base}chairman/`, description: 'Message from the Chairman' },
  { title: '組織章程', href: `${base}charter/`, description: 'Charter of the Association' },
  { title: '聯絡我們', href: `${base}contact/`, description: 'Contact Us' },
  { title: '組織架構與夥伴招募', href: `${base}join-us/`, description: 'Organization & Recruitment' },
];
---

<BaseLayout
  title="臺灣遠距藥事照護協會 Taiwan Telepharmacy Association"
  description="臺灣遠距藥事照護協會官方網站：結合科技與專業，打造優質遠距藥事團隊，提供從居家到機構的全方位照護服務。"
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="hero-badge">Professional Telemedicine</p>
      <h1>
        讓臺灣醫療專業<br />
        無遠弗屆，守護健康
      </h1>
      <p class="hero-lede">
        結合科技與專業，打造優質遠距藥事團隊，提供從居家到機構的全方位照護服務。
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#mission">認識協會理念</a>
        <a class="btn btn-outline" href="#services">服務項目</a>
      </div>
    </div>
  </section>

  <section class="mission" id="mission" aria-labelledby="mission-title">
    <div class="container">
      <div class="mission-intro">
        <div>
          <p class="section-eyebrow">ABOUT TTPA</p>
          <h2 id="mission-title">以專業連結科技，讓照護跨越距離</h2>
        </div>
        <p>
          臺灣遠距藥事照護協會致力於強化醫事人員的專業與數位應用能力，
          並透過跨域協作，將藥事照護從醫療機構延伸到社區、長照與居家場域。
        </p>
      </div>
      <div class="goal-grid">
        {
          associationGoals.map((goal, index) => (
            <article class="goal-card">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{goal.title}</h3>
              <p>{goal.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="services" id="services">
    <div class="container">
      <h2>我們可以做的地方</h2>
      <p class="section-lede">針對市場需求，整合專業與科技，提供具競爭力的解決方案</p>
      <div class="services-grid">
        {
          services.map((service) => (
            <div class="service-card">
              <h3>{service.title}</h3>
              <p>{service.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="gallery" aria-labelledby="activity-title">
    <div class="container">
      <p class="section-eyebrow section-eyebrow-centered">LATEST ACTIONS</p>
      <h2 id="activity-title">近期實體活動與成果</h2>
      <p class="section-lede">從場域實作、人才培訓到醫藥科技媒合，看見協會如何將專業轉化為現場行動。</p>
      <div class="activity-grid">
        {
          activityHighlights.map((item) => (
            <a class="activity-card" href={item.href}>
              <div class="activity-image">
                <img src={item.src} alt={item.alt} loading="lazy" width="720" height="480" />
                <span class:list={['activity-status', `activity-status-${item.tone}`]}>{item.status}</span>
              </div>
              <div class="activity-body">
                <p class="activity-kind">{item.kind}</p>
                <h3>{item.title}</h3>
                <p class="activity-date">{item.dateLabel}</p>
                <p class="activity-summary">{item.summary}</p>
                <span class="activity-link">{item.cta} <span aria-hidden="true">→</span></span>
              </div>
            </a>
          ))
        }
      </div>
      <div class="gallery-actions">
        <a class="gallery-cta gallery-cta-outline" href={`${base}events/`}>查看活動報名 <span aria-hidden="true">→</span></a>
        <a class="gallery-cta" href={`${base}results/`}>探索完整活動成果 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="vision" aria-labelledby="chairman-vision-title">
    <div class="container vision-inner">
      <img
        class="vision-photo"
        src={chairmanVisionPhoto}
        alt="劉孟基 理事長"
        width="480"
        height="360"
        loading="lazy"
      />
      <div class="vision-content">
        <p class="section-eyebrow">協會願景</p>
        <h2 id="chairman-vision-title">從專業扎根，讓遠距照護走得更遠</h2>
        <p class="vision-tag">劉孟基　TTPA 理事長</p>
        <blockquote>
          「我們期待將『遠距藥事』的服務擴展到其他國家，讓臺灣的醫療專業可以無遠弗屆。」
        </blockquote>
        <a class="vision-link" href={chairmanUrl}>閱讀理事長的話 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="partners">
    <div class="container">
      <h2>合作夥伴</h2>
      <p class="section-lede">串連醫療、藥事、教育與科技夥伴，共同推動更完整的照護與數位應用。</p>
    </div>

    <div class="partners-marquee" aria-label={`合作夥伴，共 ${partners.length} 個單位`}>
      <div class="partners-track">
        <div class="partners-set">
          {
            partners.map((partner) => (
              <a class="partner-card" href={partner.website} target="_blank" rel="noopener noreferrer">
                <img src={partner.src} alt={partner.alt} loading="lazy" width="200" height="110" />
                <span>{partner.name}</span>
              </a>
            ))
          }
        </div>

        <div class="partners-set" aria-hidden="true">
          {
            partners.map((partner) => (
              <span class="partner-card partner-card-copy">
                <img src={partner.src} alt="" loading="lazy" width="200" height="110" />
                <span>{partner.name}</span>
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="container">
      <a class="partners-cta" href={`${base}links/#organizations`}>查看所有合作夥伴 <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="more">
    <div class="container">
      <h2>認識協會更多</h2>
      <div class="more-grid">
        {
          homeSubpages.map((page) => (
            <Card href={page.href} title={page.title} description={page.description} cta="前往閱讀" />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style define:vars={{ heroBgUrl: `url(${heroBgUrl})` }}>
  section {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  h2 {
    color: var(--color-primary);
    text-align: center;
    margin-block: 0 0.5rem;
  }

  .section-lede {
    text-align: center;
    color: var(--color-ink-soft);
    max-width: 40rem;
    margin: 0 auto clamp(1.5rem, 4vw, 2.5rem);
  }

  .section-eyebrow {
    margin: 0 0 0.5rem;
    color: var(--color-accent-dark);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .section-eyebrow-centered {
    text-align: center;
  }

  /* Hero */
  .hero {
    background: linear-gradient(var(--color-primary-a80), var(--color-primary-a60)),
      var(--heroBgUrl) center/cover no-repeat;
    color: var(--color-white);
    padding-block: clamp(3.5rem, 12vw, 7rem);
  }

  .hero-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.25rem 1rem;
    border-radius: 999px;
    background: var(--color-white-a20);
    font-size: var(--text-sm);
    margin: 0;
  }

  .hero h1 {
    margin: 0;
    color: var(--color-white);
    text-shadow: var(--shadow-text);
    font-size: var(--text-3xl);
  }

  .hero-lede {
    max-width: 40rem;
    font-size: var(--text-lg);
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-white);
  }

  .btn-primary:hover {
    background: var(--color-accent-dark);
    color: var(--color-white);
  }

  .btn-outline {
    border: 1px solid var(--color-white);
    color: var(--color-white);
  }

  .btn-outline:hover {
    background: var(--color-white-a20);
    color: var(--color-white);
  }

  /* Mission */
  .mission {
    background: var(--color-white);
  }

  .mission-intro {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
  }

  .mission-intro h2 {
    max-width: 35rem;
    margin: 0;
    text-align: left;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.25;
  }

  .mission-intro > p {
    max-width: 40rem;
    margin: 0;
    color: var(--color-ink-soft);
    line-height: 1.85;
  }

  .goal-grid {
    display: grid;
    gap: 1rem;
  }

  .goal-card {
    position: relative;
    min-height: 100%;
    padding: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background: linear-gradient(145deg, var(--color-white), var(--color-brand-soft));
  }

  .goal-card > span {
    display: block;
    margin-bottom: 1.25rem;
    color: var(--color-brand);
    font-size: var(--text-lg);
    font-weight: 800;
  }

  .goal-card h3 {
    color: var(--color-primary);
    margin-block: 0 0.65rem;
  }

  .goal-card p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  /* Chairman vision */
  .vision {
    background: var(--color-bg-light);
  }

  .vision-inner {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    align-items: center;
  }

  .vision-photo {
    width: min(100%, 14rem);
    margin-inline: auto;
    border-radius: 1rem;
    box-shadow: var(--shadow-card);
  }

  .vision-content {
    max-width: 42rem;
  }

  .vision-tag {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    margin: 0 0 1rem;
  }

  .vision-content h2 {
    text-align: left;
    margin-bottom: 0.5rem;
  }

  blockquote {
    margin: 0 0 1.25rem;
    padding-inline-start: 1rem;
    border-inline-start: 0.25rem solid var(--color-brand);
    color: var(--color-primary-dark);
    font-size: var(--text-lg);
  }

  .vision-link {
    color: var(--color-accent-dark);
    font-weight: 700;
  }

  /* Services */
  .services {
    background: var(--color-brand-soft);
  }

  .services-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  .service-card {
    background: var(--color-white);
    border-radius: 0.75rem;
    padding: 1.5rem;
    box-shadow: var(--shadow-card);
  }

  .service-card h3 {
    color: var(--color-primary);
    margin-block: 0 0.5rem;
  }

  .service-card p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  /* Activities and results */
  .gallery {
    background: var(--color-white);
  }

  .activity-grid {
    display: grid;
    gap: 1.25rem;
  }

  .activity-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background: var(--color-white);
    box-shadow: var(--shadow-card);
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .activity-card:hover,
  .activity-card:focus-visible {
    border-color: var(--color-brand);
    box-shadow: var(--shadow-card-hover);
    color: var(--color-ink);
    transform: translateY(-0.2rem);
  }

  .activity-image {
    position: relative;
    overflow: hidden;
  }

  .activity-image img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .activity-status {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: var(--color-white);
    box-shadow: var(--shadow-card);
    font-size: var(--text-xs);
    font-weight: 800;
  }

  .activity-status-open {
    color: var(--color-accent-dark);
  }

  .activity-status-ongoing {
    color: var(--color-primary);
  }

  .activity-status-completed {
    color: var(--color-ink-soft);
  }

  .activity-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem;
  }

  .activity-kind {
    margin: 0 0 0.4rem;
    color: var(--color-accent-dark);
    font-size: var(--text-xs);
    font-weight: 800;
  }

  .activity-card h3 {
    margin-block: 0 0.65rem;
    color: var(--color-primary-dark);
    font-size: var(--text-lg);
    line-height: 1.4;
  }

  .activity-date {
    margin: 0 0 0.75rem;
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .activity-summary {
    margin: 0 0 1rem;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .activity-link {
    margin-top: auto;
    color: var(--color-accent-dark);
    font-size: var(--text-sm);
    font-weight: 800;
  }

  .gallery-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .gallery-cta {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.7rem 1.2rem;
    border-radius: 999rem;
    background: var(--color-accent);
    color: var(--color-white);
    font-weight: 700;
    text-decoration: none;
  }

  .gallery-cta:hover {
    background: var(--color-accent-dark);
    color: var(--color-white);
  }

  .gallery-cta-outline {
    border: 1px solid var(--color-accent);
    background: transparent;
    color: var(--color-accent-dark);
  }

  /* Partners */
  .partners {
    overflow: hidden;
    background: var(--color-brand-soft);
  }

  .partners-marquee {
    overflow: hidden;
    padding-block: 0.5rem;
  }

  .partners-track {
    display: flex;
    width: max-content;
    animation: partners-scroll 48s linear infinite;
    will-change: transform;
  }

  .partners-marquee:hover .partners-track,
  .partners-marquee:focus-within .partners-track {
