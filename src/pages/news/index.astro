---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const imageSrc = (path?: string) =>
  path ? (/^https?:\/\//.test(path) ? path : `${base}${path}`) : undefined;

const isEnded = (status?: string) => /已結束/.test(status ?? '');

const eventResultRoutes: Record<string, string> = {
  'ai-pharma-tech-matching': 'ai-pharma-tech-matching',
  'ai-workshop-taichung-tzuchi': 'nationwide-medical-ai-workshops',
  'yuanrung-hospital-seminar': 'yuanrung-medical-informatics',
};

const announcementResultRoutes: Record<string, string> = {
  'zuoying-hospital-workshop': 'nationwide-medical-ai-workshops',
};

type NewsItem = {
  key: string;
  kind: '公告' | '活動' | '課程';
  title: string;
  subtitle?: string;
  summary?: string;
  dateLabel?: string;
  status?: string;
  href?: string;
  image?: string;
  sortDate: number;
  dateIso?: string;
  displayDate: string;
  ctaLabel?: string;
  leadsToResult: boolean;
};

const events = await getCollection('events', (entry) => entry.data.featured === true);
const courses = await getCollection('courses', (entry) => entry.data.featured === true);
const announcements = await getCollection('announcements');

const formatDisplayDate = (date?: Date) => {
  if (!date) return '日期待定';
  return new Intl.DateTimeFormat('zh-TW', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date);
};

const items: NewsItem[] = [
  ...events.map((event) => {
    const resultSlug = eventResultRoutes[event.id];
    const leadsToResult = isEnded(event.data.status) && Boolean(resultSlug);
    const href = leadsToResult
      ? `${base}results/${resultSlug}/`
      : `${base}events/${event.id}/`;

    return {
      key: `event-${event.id}`,
      kind: '活動' as const,
      title: event.data.title,
      subtitle: event.data.subtitle,
      summary: event.data.summary,
      dateLabel: event.data.dateLabel,
      status: event.data.status,
      href,
      image: imageSrc(event.data.image),
      sortDate: event.data.date ? event.data.date.getTime() : 0,
      dateIso: event.data.date?.toISOString().slice(0, 10),
      displayDate: formatDisplayDate(event.data.date),
      ctaLabel: leadsToResult ? '查看活動成果' : '查看活動資訊',
      leadsToResult,
    };
  }),
  ...courses.map((course) => ({
    key: `course-${course.id}`,
    kind: '課程' as const,
    title: course.data.title,
    summary: course.data.summary,
    dateLabel: course.data.dateLabel,
    status: course.data.status,
    href: `${base}courses/${course.id}/`,
    image: imageSrc(course.data.image),
    sortDate: course.data.date ? course.data.date.getTime() : 0,
    dateIso: course.data.date?.toISOString().slice(0, 10),
    displayDate: formatDisplayDate(course.data.date),
    ctaLabel: '查看課程內容',
    leadsToResult: false,
  })),
  ...announcements.map((announcement) => {
    const resultSlug = announcementResultRoutes[announcement.id];
    const leadsToResult = isEnded(announcement.data.status) && Boolean(resultSlug);
    const href = leadsToResult
      ? `${base}results/${resultSlug}/`
      : announcement.data.link;

    return {
      key: `announcement-${announcement.id}`,
      kind: '公告' as const,
      title: announcement.data.title,
      summary: announcement.data.summary,
      dateLabel: announcement.data.date
        ? formatDisplayDate(announcement.data.date)
        : undefined,
      status: announcement.data.status,
      href,
      sortDate: announcement.data.date ? announcement.data.date.getTime() : 0,
      dateIso: announcement.data.date?.toISOString().slice(0, 10),
      displayDate: formatDisplayDate(announcement.data.date),
      ctaLabel: leadsToResult ? '查看活動成果' : href ? '查看公告' : undefined,
      leadsToResult,
    };
  }),
];

items.sort((a, b) => b.sortDate - a.sortDate);
---

<BaseLayout
  title="最新消息｜臺灣遠距藥事照護協會"
  description="臺灣遠距藥事照護協會最新消息，依日期由新到舊整理活動、課程、公告與活動成果。"
>
  <section class="page-hero">
    <div class="container hero-inner">
      <p class="eyebrow">LATEST NEWS &amp; EVENTS</p>
      <h1>最新消息</h1>
      <p class="lede">掌握協會近期活動、專業課程與合作動態；最新資訊置頂，依序向下瀏覽。</p>
    </div>
  </section>

  <section class="news-list" aria-labelledby="news-list-title">
    <div class="container">
      <header class="list-heading">
        <div>
          <p class="section-kicker">協會動態</p>
          <h2 id="news-list-title">由新到舊，一次掌握</h2>
        </div>
        <p>活動結束且已有成果紀錄時，可直接前往成果專區查看內容與照片。</p>
      </header>

      {
        items.length === 0 ? (
          <p class="empty">目前尚無最新消息。</p>
        ) : (
          <ol class="news-feed" aria-label="最新消息，依日期由新到舊排列">
            {items.map((item) => (
              <li class:list={['news-entry', { 'is-result': item.leadsToResult }]}>
                <time class="date-marker" datetime={item.dateIso}>
                  {item.displayDate}
                </time>

                {item.href ? (
                  <a
                    class="news-card"
                    href={item.href}
                    target={/^https?:\/\//.test(item.href) ? '_blank' : undefined}
                    rel={/^https?:\/\//.test(item.href) ? 'noopener noreferrer' : undefined}
                  >
                    {item.image && (
                      <figure class="news-visual">
                        <img src={item.image} alt="" loading="lazy" width="480" height="320" />
                      </figure>
                    )}
                    <div class="news-card-body">
                      <div class="news-card-top">
                        <span class:list={['kind', `kind-${item.kind}`]}>{item.kind}</span>
                        <StatusBadge status={item.status} />
                        {item.leadsToResult && <span class="result-label">成果已上線</span>}
                      </div>
                      <h3>{item.title}</h3>
                      {item.subtitle && <p class="news-subtitle">{item.subtitle}</p>}
                      {item.dateLabel && <p class="news-date">{item.dateLabel}</p>}
                      {item.summary && <p class="news-summary">{item.summary}</p>}
                      {item.ctaLabel && <span class="cta">{item.ctaLabel}<span aria-hidden="true">→</span></span>}
                    </div>
                  </a>
                ) : (
                  <article class="news-card news-card-static">
                    <div class="news-card-body">
                      <div class="news-card-top">
                        <span class:list={['kind', `kind-${item.kind}`]}>{item.kind}</span>
                        <StatusBadge status={item.status} />
                      </div>
                      <h3>{item.title}</h3>
                      {item.subtitle && <p class="news-subtitle">{item.subtitle}</p>}
                      {item.dateLabel && <p class="news-date">{item.dateLabel}</p>}
                      {item.summary && <p class="news-summary">{item.summary}</p>}
                    </div>
                  </article>
                )}
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background:
      radial-gradient(circle at 84% 18%, color-mix(in srgb, var(--color-accent) 13%, transparent), transparent 28rem),
      var(--color-brand-soft);
    padding-block: clamp(2.75rem, 7vw, 5rem);
  }

  .hero-inner {
    max-width: 72rem;
  }

  .eyebrow,
  .section-kicker {
    margin: 0 0 0.5rem;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .page-hero h1 {
    margin: 0;
    color: var(--color-primary);
  }

  .lede {
    max-width: 42rem;
    margin: 0.75rem 0 0;
    color: var(--color-ink-soft);
  }

  .news-list {
    padding-block: clamp(2.5rem, 7vw, 5rem);
  }

  .list-heading {
    display: grid;
    gap: 0.75rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-line);
  }

  .list-heading h2 {
    margin: 0;
    color: var(--color-primary);
    font-size: clamp(1.5rem, 3vw, 2.15rem);
  }

  .list-heading > p {
    max-width: 34rem;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .empty {
    padding-block: 2rem;
    color: var(--color-ink-soft);
    text-align: center;
  }

  .news-feed {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .news-entry {
    display: grid;
    gap: 0.65rem;
  }

  .date-marker {
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .news-card {
    display: grid;
    overflow: hidden;
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    box-shadow: var(--shadow-card);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  a.news-card:hover,
  a.news-card:focus-visible {
    color: var(--color-text);
    border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-line));
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-0.125rem);
  }

  a.news-card:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    outline-offset: 3px;
  }

  .is-result .news-card {
    border-left: 0.25rem solid var(--color-accent);
  }

  .news-visual {
    margin: 0;
    background: var(--color-brand-soft);
  }

  .news-visual img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .news-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-width: 0;
    padding: clamp(1.15rem, 3vw, 1.75rem);
  }

  .news-card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .kind,
  .result-label {
    display: inline-flex;
    align-items: center;
    min-height: 1.65rem;
    padding-inline: 0.65rem;
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 800;
  }

  .kind {
    color: var(--color-primary);
    background: var(--color-brand-soft);
  }

  .kind-課程 {
    color: var(--color-accent);
  }

  .result-label {
    color: var(--color-white);
    background: var(--color-accent);
  }

  .news-card h3 {
    margin: 0.15rem 0 0;
    color: var(--color-primary);
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    line-height: 1.35;
  }

  .news-subtitle,
  .news-date,
  .news-summary {
    margin: 0;
  }

  .news-subtitle {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .news-date {
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
  }

  .news-summary {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    align-self: flex-start;
    margin-top: 0.35rem;
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 800;
  }

  .news-card:hover .cta span,
  .news-card:focus-visible .cta span {
    transform: translateX(0.2rem);
  }

  .cta span {
    transition: transform 0.2s ease;
  }

  .news-card-static {
    cursor: default;
  }

  @media (min-width: 720px) {
    .list-heading {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.65fr);
      align-items: end;
    }

    .news-feed {
      gap: 1.5rem;
    }

    .news-entry {
      grid-template-columns: 7.25rem minmax(0, 1fr);
      gap: 1.5rem;
      align-items: start;
    }

    .date-marker {
      padding-top: 1.35rem;
      text-align: right;
    }

    .news-card:has(.news-visual) {
      grid-template-columns: clamp(13rem, 25vw, 18rem) minmax(0, 1fr);
    }

    .news-visual img {
      aspect-ratio: auto;
      min-height: 100%;
    }
  }

  @media (max-width: 719px) {
    .news-entry + .news-entry {
      padding-top: 0.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .news-card,
    .cta span {
      transition: none;
    }
  }
</style>
