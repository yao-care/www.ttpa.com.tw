---
// 組織架構與夥伴招募。內容逐字取自 .source/05-org.md（組織架構圖／六大分組招募／報名流程與權益），
// 未增刪潤飾。組織圖依原站文字方塊＋連接線之層級關係逐項列出（05-org.md:21 擷取者已註明
// 原站以圖形呈現、非表格）。
import BaseLayout from '../layouts/BaseLayout.astro';

// 逐字取自 05-org.md:47-99，六大分組
const groups = [
  {
    title: '1. 活動企劃組',
    subtitle: '專案與活動設計執行',
    traits: '特質：創意力強、專案執行力、能掌控時程、抗壓性高。',
    bonus: '加分：有辦活動經驗，熟悉簡報設計或專案工具 (Trello, Notion)。',
    tasks: '主要任務：年度課程規劃、流程設計、廠商講者協調、撰寫計畫書與報告。',
  },
  {
    title: '2. 行銷推廣組',
    subtitle: '宣傳與品牌形象',
    traits: '特質：擅長文字視覺表達、熟悉社群操作、具行銷思維。',
    bonus: '加分：能獨立製作宣傳素材 (Canva, AI繪圖, 影片剪輯)。',
    tasks: '主要任務：行銷計畫設計、素材製作、經營社群平台、活動報名推廣。',
  },
  {
    title: '3. 後勤庶務組',
    subtitle: '行政與內部支持',
    traits: '特質：細心、耐心、紀律性高、樂於支援團隊、溝通協調力佳。',
    bonus: '加分：有行政庶務經驗，熟悉文書處理與檔案管理。',
    tasks: '主要任務：會議安排紀錄、檔案管理、活動現場支援、會員資料維護。',
  },
  {
    title: '4. 財務組',
    subtitle: '經費管理與財務出入',
    traits: '特質：嚴謹、誠信、數字敏感度高、具備財務規劃能力。',
    bonus: '加分：具會計或財務背景，能熟練使用 Excel 或會計軟體。',
    tasks: '主要任務：收支管理、編列年度預算與報表、收費退款流程、贊助財務追蹤。',
  },
  {
    title: '5. 客戶關係組',
    subtitle: '會員與參與者經營',
    traits: '特質：親和力強、耐心傾聽、解決問題能力佳、服務導向。',
    bonus: '加分：有客服或會員管理經驗，能妥善處理抱怨與衝突。',
    tasks: '主要任務：會員出入會服務、滿意度調查、建立關懷制度、社群互動聯繫。',
  },
  {
    title: '6. 合作發展組',
    subtitle: '外部資源與合作拓展',
    traits: '特質：擅長談判協調、具對外拓展能力、具戰略思維與國際觀。',
    bonus: '加分：有產學合作、對外聯繫或國際交流經驗。',
    tasks: '主要任務：對接產官學界與機構、開發跨領域合作、爭取贊助與戰略夥伴。',
  },
];
---

<BaseLayout
  title="組織架構與招募 | 臺灣遠距藥事照護協會 Taiwan Telepharmacy Association"
  description="TTPA 秘書處正在尋找充滿熱忱、有志於推動醫療數位轉型與遠距照護發展的夥伴。"
>
  <section class="page">
    <div class="container">
      <p class="eyebrow">Organization &amp; Recruitment</p>
      <h1>組織架構與招募</h1>

      <h2>協會組織架構</h2>
      <ul class="org-chart">
        <li>
          會員大會
          <ul>
            <li>
              理事會（理事長） → 秘書處（秘書長）
              <ul>
                <li>
                  秘書處下轄六大分組：
                  <ul>
                    <li>活動企劃組</li>
                    <li>行銷推廣組</li>
                    <li>後勤庶務組</li>
                    <li>財務組</li>
                    <li>客戶關係組</li>
                    <li>合作發展組</li>
                  </ul>
                </li>
              </ul>
            </li>
            <li>監事會（常務監事）</li>
          </ul>
        </li>
      </ul>

      <div class="badge">Join Our Core Team</div>
      <h2>邀請您加入核心幕僚團隊！</h2>
      <p class="lede">
        TTPA
        秘書處正在尋找充滿熱忱、有志於推動醫療數位轉型與遠距照護發展的夥伴。我們規劃了以下六大功能小組，無論您的專長為何，都能在這裡找到發揮的舞台。
      </p>

      <div class="groups-grid">
        {
          groups.map((group) => (
            <div class="group-card">
              <h3>{group.title}</h3>
              <p class="group-subtitle">{group.subtitle}</p>
              <p>📌 {group.traits}</p>
              <p>⭐ {group.bonus}</p>
              <p class="group-tasks">{group.tasks}</p>
            </div>
          ))
        }
      </div>

      <h2>報名流程與夥伴權益</h2>

      <div class="flow-grid">
        <div class="flow-col">
          <h3>加入流程</h3>
          <ol>
            <li>
              初步通知參與意願
              <p>
                請透過協會 Email（
                <a href="mailto:ttpa2014@gmail.com?subject=我想成為TTPA好夥伴!">ttpa2014@gmail.com</a>
                ）通知我們，信件主旨請務必標明：我想成為TTPA好夥伴!
              </p>
            </li>
            <li>
              填寫申請表單
              <p>完成下方線上報名表單填寫，讓我們更了解您的專長與有興趣參與的組別。</p>
            </li>
          </ol>
        </div>

        <div class="flow-col">
          <h3>夥伴專屬權益</h3>
          <ul>
            <li>成為工作夥伴不強制入會，歡迎任何有熱忱的夥伴參與。</li>
            <li>服務滿半年者，協會將提供免收首次入會費之福利。</li>
            <li>服務滿一年者，可免收當年度之常年會費。</li>
          </ul>
        </div>
      </div>

      <div class="cta-actions">
        <a class="btn btn-primary" href="mailto:ttpa2014@gmail.com?subject=我想成為TTPA好夥伴!">
          Step 1. 發送意願信件
        </a>
        <a class="btn btn-outline" href="https://forms.gle/VEceR7m15DrVp4mz5" target="_blank" rel="noopener noreferrer">
          Step 2. 填寫報名表單
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .eyebrow {
