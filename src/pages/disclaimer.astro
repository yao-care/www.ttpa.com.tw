<BaseLayout
  title="免責聲明 | 臺灣遠距藥事照護協會 Taiwan Telepharmacy Association"
  description="本網頁所載的所有資料、商標、標誌、圖像、短片、聲音檔案、連結及其他資料等，只供參考之用，本網站將會隨時更改資料，並不作另行通知。"
>
  <section class="page">
    <div class="container">
      <h1>免責聲明</h1>

      {
        sections.map((section) => (
          <section class="clause">
            <h2>{section.title}</h2>
            {section.paragraphs.map((p) => <p>{p}</p>)}
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  h1 {
    color: var(--color-primary);
    margin-block: 0 2rem;
  }

  .clause {
    max-width: 48rem;
    margin-bottom: 2rem;
  }

  .clause h2 {
    color: var(--color-primary);
    margin-block: 0 0.75rem;
  }

  .clause p {
    margin: 0 0 1rem;
    color: var(--color-text);
  }
</style>
