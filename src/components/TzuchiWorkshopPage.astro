---
import BaseLayout from '../layouts/BaseLayout.astro';

const { event } = Astro.props;
const { title, dateLabel, location, summary, image } = event.data;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${base}${path}`;

const credits = [
  ['12 學分', '藥師持續教育學分'],
  ['12 學分', '護理師持續教育學分'],
  ['16 小時', '遠距藥事訓練證書'],
];

const certificates = [
  { image: 'img/tzuchi-certificate-hours.png', title: '國際版遠距時數證明書', text: '完成課程培訓者，即可依照出席時數獲得臺灣遠距時數證明。' },
  { image: 'img/tzuchi-certificate-ai-basic.png', title: '國際版 AI 醫療應用初階證明書', text: '完成初階完整培訓課程，並通過初階測驗者即可獲得。' },
  { image: 'img/tzuchi-certificate-ai-advanced.png', title: '國際版 AI 醫療應用進階證明書', text: '完成高階完整培訓課程，並通過高階測驗者即可獲得。' },
];

const features = [
  { icon: '↗', title: '工作效率倍增', text: '運用 Gemini、NotebookLM 與 ChatGPT，快速整理資料、撰寫文案與建立簡報架構。' },
  { icon: '◎', title: '精準衛教生成', text: '將艱深資訊轉化為清楚、易懂的衛教內容，協助醫病溝通更有效率。' },
  { icon: '⌁', title: '學術研究輔助', text: '建立資料整理、文獻摘要與知識管理流程，讓研究與日常工作更有系統。' },
];

const plans = [
  { label: '早鳥方案', price: 'NT$6,000', note: '2026/06/30 前完成報名', featured: true },
  { label: '協會／院內方案', price: 'NT$5,500', note: 'TTPA 會員或台中慈濟院內同仁' },
  { label: '學生方案', price: 'NT$4,950', note: '報名時須提供有效學生證明' },
  { label: '複訓方案', price: 'NT$1,980', note: '曾參與本系列課程之學員' },
];

const dayOne = [
  ['09:00–09:30', '學員報到與入座'],
  ['09:30–12:30', '【知識庫建立】劉孟基主任：Notion 醫療行政文檔管理應用'],
  ['13:30–16:30', '【文獻解讀】黃信溢（茶米老師）：NotebookLM 文獻筆記工具應用'],
];

const dayTwo = [
  ['09:00–09:30', '學員報到與入座'],
  ['09:30–12:30', '【生成式 AI】毛志民主任：生成式 AI 醫療衛生教育實務應用'],
  ['13:30–16:30', '【排版神器】翁紹恩主任：Gemini 臨床簡報實務應用'],
];

const faculty = [
  { image: 'img/tzuchi-instructor-liu-mengji.png', name: '劉孟基', role: '員榮醫院藥劑科主任／TTPA 理事長', text: 'Day 1 上午：Notion 醫療行政文檔管理應用。' },
  { image: 'img/tzuchi-instructor-huang-xinyi.png', name: '黃信溢（茶米老師）', role: '沃克資訊有限公司總編輯', text: 'Day 1 下午：NotebookLM 文獻筆記工具應用。' },
  { image: 'img/tzuchi-instructor-mao-zhimin.png', name: '毛志民', role: '高雄榮總藥事照護中心主任', text: 'Day 2 上午：生成式 AI 醫療衛生教育實務應用。' },
  { image: 'img/tzuchi-instructor-weng-shaoen.png', name: '翁紹恩（歪樓藥師）', role: '臺北市立聯合醫院中興院區藥劑科主任', text: 'Day 2 下午：Gemini 臨床簡報實務應用。' },
];

const faqs = [
  ['我完全不懂程式語言，適合參加嗎？', '絕對適合。本工作坊專為非工程背景的醫療專業與行政人員設計，重點是使用現成 AI 工具解決工作問題，無須任何程式經驗。'],
  ['參加工作坊有提供繼續教育學分嗎？', '本課程已申請相關繼續教育積分，完課後依當期規定協助登錄；實際積分與核發資格以課程及主管機關規範為準。'],
  ['上課需要自備電腦嗎？', '現場電腦教室已備妥上課所需設備，可直接使用；若習慣自己的設備，也歡迎自備筆記型電腦。'],
];

const refundRules = [
  '申請退費時，須提供報名收據或付款證明。',
  '可透過 LINE 群組或協會電子郵件提出退費申請。',
  '退費款項於核准後 7 個工作天內完成處理。',
  '若因不可抗力因素導致主辦方停課，將全額退費或提供轉期選擇。',
  '名額轉讓須於課程開始前 7 天內辦理，並經協會秘書處審核。',
  '超過退費期限者，可於至少 7 天前提出一次免費轉期至同等級工作坊。',
];
---

<BaseLayout title={`${title}｜台灣藥學發展協會`} description={summary}>
  <nav class="workshop-nav" aria-label="本頁導覽">
    <div class="container workshop-nav-inner">
      <a class="workshop-brand" href="#top"><span aria-hidden="true">AI</span> 高效工作坊</a>
      <div class="workshop-links">
        <a href="#outcomes">學習成果</a>
        <a href="#schedule">課程表</a>
        <a href="#faculty">講師陣容</a>
        <a href="#faq">常見問題</a>
      </div>
      <a class="workshop-state" href={`${base}events/`}>活動已結束</a>
    </div>
  </nav>

  <main id="top" class="workshop-page">
    <section class="hero">
      <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
      <div class="hero-orb hero-orb-two" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow"><span aria-hidden="true"></span> 台中慈濟醫院場 · 活動紀錄</p>
          <h1>賦能醫療專業<br /><em>掌握 AI 在醫藥的實務應用</em></h1>
          <p class="hero-summary">{summary}</p>
          <div class="hero-facts" aria-label="活動資訊">
            <div><strong>日期</strong><span>{dateLabel}</span></div>
            <div><strong>地點</strong><span>{location}</span></div>
          </div>
          <div class="hero-actions">
            <a class="button button-primary" href="#schedule">查看課程內容 <span aria-hidden="true">↓</span></a>
            <a class="button button-ghost" href={`${base}events/`}>瀏覽其他活動</a>
          </div>
          <p class="archive-note">本活動已於 2026 年 7 月 26 日結束，頁面保留完整課程資訊供參考。</p>
        </div>

        <div class="hero-visual" data-reveal data-delay="1">
          <div class="hero-image-frame">
            <img src={asset(image)} alt="AI 高效工作坊台中慈濟醫院場活動主視覺" width="1600" height="900" />
            <span class="image-label">醫療 × AI × 實作</span>
          </div>
          <div class="floating-card floating-card-top"><span>2</span> 天密集實作</div>
          <div class="floating-card floating-card-bottom"><span>3</span> 類完訓成果</div>
        </div>
      </div>
    </section>

    <section class="service-strip" aria-label="課程服務">
      <div class="container service-grid">
        <span>✓ 現場備妥電腦</span>
        <span>✓ 免費提供中餐</span>
        <span>✓ 停車補助 NT$200／日</span>
      </div>
    </section>

    <section class="section outcomes" id="outcomes">
      <div class="container">
        <header class="section-heading" data-reveal>
          <p class="eyebrow">COURSE OUTCOMES</p>
          <h2>兩天完成，帶走可用的 AI 能力</h2>
          <p>不只認識工具，更透過練習把 AI 放進真實醫療工作情境。</p>
        </header>
        <div class="credit-grid">
          {credits.map(([value, label], index) => (
            <article data-reveal data-delay={String(index)}><strong>{value}</strong><span>{label}</span></article>
          ))}
        </div>
        <div class="feature-grid">
          {features.map((feature, index) => (
            <article class="feature-card" data-reveal data-delay={String(index)}>
              <span class="feature-icon" aria-hidden="true">{feature.icon}</span>
              <h3>{feature.title}</h3><p>{feature.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section certificates">
      <div class="container">
        <header class="section-heading" data-reveal>
          <p class="eyebrow">CERTIFICATES</p>
          <h2>完訓成果與證明</h2>
          <p>依課程完成情形與測驗結果，取得對應的學習成果證明。</p>
        </header>
        <div class="certificate-grid">
          {certificates.map((certificate, index) => (
            <article class="certificate-card" data-reveal data-delay={String(index)}>
              <div class="certificate-image"><img src={asset(certificate.image)} alt={`${certificate.title}示意圖`} width="1000" height="707" loading="lazy" /></div>
              <div><h3>{certificate.title}</h3><p>{certificate.text}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section pricing" aria-labelledby="pricing-title">
      <div class="container">
        <header class="section-heading" data-reveal>
          <p class="eyebrow">HISTORICAL PRICING</p>
          <h2 id="pricing-title">當期報名方案</h2>
          <p>以下為本場活動當期費用紀錄；活動現已結束，不再受理報名。</p>
        </header>
        <div class="pricing-grid">
          {plans.map((plan, index) => (
            <article class:list={['price-card', { featured: plan.featured }]} data-reveal data-delay={String(index)}>
              {plan.featured && <span class="plan-tag">當期熱門</span>}
              <h3>{plan.label}</h3><strong>{plan.price}</strong><span>／人</span><p>{plan.note}</p>
            </article>
          ))}
        </div>
        <p class="price-footnote">原價 NT$6,600／人；三人以上團體報名，依對應身分每人再折 NT$500。</p>
      </div>
    </section>

    <section class="section schedule" id="schedule">
      <div class="container">
        <header class="section-heading" data-reveal>
          <p class="eyebrow">TWO-DAY PROGRAM</p>
          <h2>兩日實作課程表</h2>
          <p>從工具基礎到整合應用，循序建立自己的 AI 工作流程。</p>
        </header>
        <div class="schedule-grid">
          {[{ day: 'Day 1', date: '07/25（六）', items: dayOne }, { day: 'Day 2', date: '07/26（日）', items: dayTwo }].map((schedule, index) => (
            <article class="day-card" data-reveal data-delay={String(index)}>
              <header><span>{schedule.day}</span><h3>{schedule.date}</h3></header>
              <ol>
                {schedule.items.map(([time, subject]) => <li><time>{time}</time><span>{subject}</span></li>)}
              </ol>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section faculty" id="faculty">
      <div class="container">
        <header class="section-heading" data-reveal>
          <p class="eyebrow">FACULTY</p>
          <h2>跨域講師陣容</h2>
          <p>結合醫療專業、數位轉型與生成式 AI 的實務經驗。</p>
        </header>
        <div class="faculty-grid">
          {faculty.map((person, index) => (
            <article class="faculty-card" data-reveal data-delay={String(index)}>
              <div class="faculty-photo"><img src={asset(person.image)} alt={`${person.name}講師`} width="800" height="800" loading="lazy" /></div>
              <div><h3>{person.name}</h3><strong>{person.role}</strong><p>{person.text}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section faq" id="faq">
      <div class="container narrow">
        <header class="section-heading" data-reveal>
          <p class="eyebrow">FAQ</p><h2>常見問題</h2>
        </header>
        <div class="faq-list">
          {faqs.map(([question, answer], index) => (
            <details data-reveal data-delay={String(index)}>
              <summary><span>{question}</span><i aria-hidden="true">＋</i></summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="closing">
      <div class="container closing-inner" data-reveal>
        <div><p class="eyebrow">KEEP LEARNING</p><h2>活動雖已結束，學習仍可繼續</h2><p>前往活動專區查看協會最新課程、論壇與專業交流機會。</p></div>
        <a class="button button-light" href={`${base}events/`}>查看最新活動 <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="refund" aria-labelledby="refund-title">
      <div class="container narrow">
        <h2 id="refund-title">退費與課程異動說明</h2>
        <ul>{refundRules.map((rule) => <li>{rule}</li>)}</ul>
        <p>如需查詢歷史報名資料，請聯絡 <a href="mailto:ttpa2014@gmail.com">ttpa2014@gmail.com</a>。</p>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reducedMotion || !('IntersectionObserver' in window)) {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
    revealItems.forEach((item) => observer.observe(item));
  }
</script>

<style>
  .workshop-page { overflow: clip; background: var(--color-white); }
  .workshop-nav { position: sticky; top: var(--site-header-height); z-index: 30; border-bottom: 1px solid var(--color-workshop-a20); background: var(--color-white); box-shadow: var(--shadow-card); }
  .workshop-nav-inner { display: flex; min-height: 4.6rem; align-items: center; justify-content: space-between; gap: 1rem; }
  .workshop-brand { display: inline-flex; align-items: center; gap: .6rem; color: var(--color-workshop-dark); font-weight: 800; text-decoration: none; white-space: nowrap; }
  .workshop-brand span { display: grid; width: 2.6rem; height: 2.6rem; place-items: center; border-radius: .8rem; background: var(--color-workshop); color: var(--color-white); font-size: var(--text-xs); }
  .workshop-links { display: none; align-items: center; gap: 1.5rem; }
  .workshop-links a { color: var(--color-ink-soft); font-size: var(--text-xs); font-weight: 700; text-decoration: none; transition: color .2s ease; }
  .workshop-links a:hover, .workshop-links a:focus-visible { color: var(--color-workshop); }
  .workshop-state { padding: .55rem .9rem; border-radius: 999rem; background: var(--color-workshop-soft); color: var(--color-workshop-dark); font-size: var(--text-xs); font-weight: 800; text-decoration: none; white-space: nowrap; }
  .container { width: min(100% - 2rem, 75rem); margin-inline: auto; }
  .narrow { max-width: 52rem; }
  .hero { position: relative; padding-block: clamp(4rem, 9vw, 7.5rem); background: linear-gradient(145deg, var(--color-workshop-soft), var(--color-white)); }
  .hero-grid { position: relative; z-index: 1; display: grid; gap: 3rem; align-items: center; }
  .hero-orb { position: absolute; border-radius: 50%; background: var(--color-workshop-a10); filter: blur(1rem); pointer-events: none; }
  .hero-orb-one { width: 24rem; height: 24rem; top: -9rem; right: -8rem; }
  .hero-orb-two { width: 15rem; height: 15rem; bottom: -7rem; left: -5rem; }
  .eyebrow { margin: 0 0 .8rem; color: var(--color-workshop); font-size: var(--text-xs); font-weight: 800; letter-spacing: .08em; }
  .hero-copy > .eyebrow { display: flex; align-items: center; gap: .6rem; }
  .hero-copy > .eyebrow span { width: .65rem; height: .65rem; border-radius: 50%; background: var(--color-workshop); box-shadow: 0 0 0 .4rem var(--color-workshop-a10); }
  .hero h1 { margin: 0; color: var(--color-workshop-dark); font-size: var(--text-2xl); line-height: 1.12; letter-spacing: -.025em; }
  .hero h1 em { color: var(--color-workshop); font-style: normal; }
  .hero-summary { max-width: 42rem; margin: 1.5rem 0; color: var(--color-ink-soft); font-size: var(--text-lg); }
  .hero-facts { display: grid; gap: .75rem; padding: 1rem 0; border-block: 1px solid var(--color-workshop-tint); }
  .hero-facts div { display: grid; grid-template-columns: 4.25rem 1fr; gap: .75rem; align-items: start; }
  .hero-facts strong { color: var(--color-workshop-dark); }
  .hero-facts span { color: var(--color-ink-soft); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.5rem; }
  .button { display: inline-flex; min-height: 3.5rem; align-items: center; justify-content: center; gap: .5rem; padding: .75rem 1.4rem; border: 1px solid transparent; border-radius: .85rem; font-weight: 800; text-decoration: none; transition: transform .2s ease, box-shadow .2s ease, background .2s ease; }
  .button:hover, .button:focus-visible { transform: translateY(-.15rem); box-shadow: var(--shadow-card-hover); }
  .button-primary { background: var(--color-workshop); color: var(--color-white); }
  .button-primary:hover, .button-primary:focus-visible { background: var(--color-workshop-dark); color: var(--color-white); }
  .button-ghost { border-color: var(--color-workshop-tint); background: var(--color-white); color: var(--color-workshop-dark); }
  .archive-note { margin: 1rem 0 0; color: var(--color-ink-muted); font-size: var(--text-xs); }
  .hero-visual { position: relative; padding: 1rem; }
  .hero-image-frame { overflow: hidden; border: .6rem solid var(--color-white); border-radius: 2rem; background: var(--color-white); box-shadow: var(--shadow-card-hover); transform: rotate(1.5deg); transition: transform .35s ease; }
  .hero-image-frame:hover { transform: rotate(0deg) translateY(-.3rem); }
  .hero-image-frame img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .image-label { display: block; padding: .8rem 1rem; color: var(--color-workshop-dark); font-weight: 800; text-align: center; }
  .floating-card { position: absolute; display: flex; align-items: center; gap: .55rem; padding: .65rem .9rem; border: 1px solid var(--color-workshop-tint); border-radius: 1rem; background: var(--color-white); color: var(--color-workshop-dark); box-shadow: var(--shadow-card-hover); font-weight: 700; }
  .floating-card span { display: grid; width: 2.3rem; height: 2.3rem; place-items: center; border-radius: .75rem; background: var(--color-workshop); color: var(--color-white); }
  .floating-card-top { top: -.5rem; right: -.25rem; }
  .floating-card-bottom { bottom: -.75rem; left: -.25rem; }
  .service-strip { background: var(--color-workshop-dark); color: var(--color-white); }
  .service-grid { display: grid; gap: .8rem; padding-block: 1.15rem; text-align: center; font-weight: 700; }
  .section { padding-block: clamp(4rem, 8vw, 7rem); scroll-margin-top: 5.5rem; }
  .section-heading { max-width: 48rem; margin: 0 auto 2.5rem; text-align: center; }
  .section-heading h2, .closing h2 { margin: 0 0 .75rem; color: var(--color-workshop-dark); font-size: var(--text-2xl); }
  .section-heading > p:last-child { margin: 0; color: var(--color-ink-soft); }
  .credit-grid, .feature-grid, .certificate-grid, .pricing-grid, .faculty-grid { display: grid; gap: 1.2rem; }
  .credit-grid { margin-bottom: 1.5rem; }
  .credit-grid article { padding: 1.35rem; border-radius: 1.2rem; background: var(--color-workshop-dark); color: var(--color-white); text-align: center; box-shadow: var(--shadow-card); }
  .credit-grid strong, .credit-grid span { display: block; }
  .credit-grid strong { font-size: var(--text-xl); }
  .credit-grid span { margin-top: .25rem; color: var(--color-workshop-tint); }
  .feature-card, .certificate-card, .price-card, .day-card, .faculty-card { border: 1px solid var(--color-workshop-tint); border-radius: 1.4rem; background: var(--color-white); box-shadow: var(--shadow-card); transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease; }
  .feature-card:hover, .certificate-card:hover, .price-card:hover, .faculty-card:hover { transform: translateY(-.35rem); border-color: var(--color-workshop); box-shadow: var(--shadow-card-hover); }
  .feature-card { padding: 1.6rem; }
