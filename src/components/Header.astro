---
// 全站共用頂部導覽。
// 決定（用戶已拍板，見交辦說明與 .source/_ia-plan.md § 3、決定項 9）：
//   9 大項全部攤平放進 header，不比照原站「頂部只露 5 條」的 Google Sites 限制；
//   活動報名專區／線上課程推廣／首頁 用下拉（<details>）收納子頁；少量原生 JS
//   負責互斥開啟、離開收合與鍵盤操作，避免下拉選單彼此重疊。
// 路由對照：逐條取自 .source/_ia-plan.md § 1 路由對照表，一頁不漏、不擅自加頁。
// ⚠ 有 base 子路徑：每一條連結都經 base 組合，不硬編 /xxx。
// 2026-07-29 依協會正式回覆移除「主題專欄」（.source/_questions-for-ttpa.md A10：內容過於
// 老舊，協會要求先移除，未來再行更新），對應頁面 src/pages/columns/index.astro 已一併刪除；
// 另將章程頁的導覽標籤改為協會定案的正式名稱「組織章程」（A9，網址 /charter/ 不變）。
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

interface NavChild {
  label: string;
  href: string;
}
interface NavItem {
  label: string;
  href: string;
  children?: NavChild[];
}

const nav: NavItem[] = [
  {
    label: '首頁',
    href: base,
    children: [
      { label: '理事長的話', href: `${base}chairman/` },
      { label: '組織章程', href: `${base}charter/` },
      { label: '聯絡我們', href: `${base}contact/` },
      { label: '組織架構與夥伴招募', href: `${base}join-us/` },
    ],
  },
  { label: '最新消息', href: `${base}news/` },
  { label: '加入會員', href: `${base}membership/` },
  {
    label: '活動報名專區',
    href: `${base}events/`,
    children: [
      { label: 'AI醫藥科技媒合平台', href: `${base}events/ai-pharma-tech-matching/` },
      { label: '115年7月AI高效系列初階課程', href: `${base}events/ai-workshop-taichung-tzuchi/` },
      { label: '115年度員榮醫院醫療資訊與臨床應用研討會', href: `${base}events/yuanrung-hospital-seminar/` },
      { label: '亞洲大學附醫專班', href: `${base}events/asia-university-hospital/` },
    ],
  },
  {
    label: '線上課程推廣',
    href: `${base}courses/`,
    children: [
      { label: '115.04.18 醫療人員AI實務應用', href: `${base}courses/2026-04-18-ai-practice/` },
      { label: '115.06.20 醫療人員的AI第二大腦', href: `${base}courses/2026-06-20-second-brain/` },
    ],
  },
  { label: '協同推廣', href: `${base}co-promotion/` },
  { label: '官方連結', href: `${base}links/` },
  { label: '免責聲明', href: `${base}disclaimer/` },
];
---

<header class="site-header">
  <div class="header-inner container">
    <a class="logo-link" href={base}>
      <img src={`${base}logo.png`} alt="臺灣遠距藥事照護協會 TTPA" width="48" height="28" />
      <span class="site-title">臺灣遠距藥事照護協會</span>
    </a>

    <button class="nav-toggle-label" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="開啟主選單">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <nav id="primary-navigation" class="site-nav" aria-label="主要導覽">
      <ul>
        {
          nav.map((item) =>
            item.children ? (
              <li class="has-children">
                <details>
                  <summary>{item.label}</summary>
                  <ul class="submenu">
                    {/* 父層是 <summary> 不是連結，總覽頁若不放進下拉就變成沒有入口的孤兒頁
                        （2026-07-28 獨立複驗抓到 /courses/ 全站無路徑可達）。 */}
                    <li>
                      <a href={item.href}>{item.label === '首頁' ? '首頁' : `${item.label}總覽`}</a>
                    </li>
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href}>{child.label}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            )
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const menuButton = header?.querySelector<HTMLButtonElement>('.nav-toggle-label');
  const navigation = header?.querySelector<HTMLElement>('.site-nav');
  const dropdowns = Array.from(header?.querySelectorAll<HTMLDetailsElement>('.has-children > details') ?? []);
  const desktopLayout = window.matchMedia('(min-width: 1280px)');
  const precisePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

  const closeDropdowns = (exception?: HTMLDetailsElement) => {
    dropdowns.forEach((dropdown) => {
      if (dropdown !== exception) dropdown.open = false;
    });
  };

  const setMobileNavigation = (open: boolean) => {
    if (!menuButton || !navigation) return;
    navigation.classList.toggle('is-open', open);
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? '關閉主選單' : '開啟主選單');
    if (!open) closeDropdowns();
  };

  menuButton?.addEventListener('click', () => {
    setMobileNavigation(menuButton.getAttribute('aria-expanded') !== 'true');
  });

  dropdowns.forEach((dropdown) => {
    const item = dropdown.closest<HTMLElement>('.has-children');
    const summary = dropdown.querySelector<HTMLElement>('summary');

    dropdown.addEventListener('toggle', () => {
      if (dropdown.open) closeDropdowns(dropdown);
    });

    item?.addEventListener('pointerenter', () => {
      if (desktopLayout.matches && precisePointer.matches) {
        closeDropdowns(dropdown);
        dropdown.open = true;
      }
    });

    item?.addEventListener('pointerleave', () => {
      if (desktopLayout.matches && precisePointer.matches) dropdown.open = false;
    });

    summary?.addEventListener('click', (event) => {
      if (desktopLayout.matches && precisePointer.matches) {
        event.preventDefault();
        closeDropdowns(dropdown);
        dropdown.open = true;
      }
    });

    dropdown.addEventListener('focusout', () => {
      requestAnimationFrame(() => {
        if (!dropdown.contains(document.activeElement)) dropdown.open = false;
      });
    });
  });

  navigation?.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
    link.addEventListener('click', () => setMobileNavigation(false));
  });

  document.addEventListener('pointerdown', (event) => {
    if (header && !header.contains(event.target as Node)) {
      closeDropdowns();
      setMobileNavigation(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeDropdowns();
      setMobileNavigation(false);
      menuButton?.focus();
    }
  });

  window.addEventListener('scroll', () => {
    if (desktopLayout.matches) closeDropdowns();
  }, { passive: true });

  desktopLayout.addEventListener('change', () => setMobileNavigation(false));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-white);
    border-bottom: 1px solid var(--color-brand-tint);
    box-shadow: var(--shadow-card);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    min-height: var(--site-header-height);
    padding-block: 0.45rem;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--color-primary-dark);
  }

  .logo-link img {
    width: 2.75rem;
    height: auto;
  }

  .site-title {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-primary-dark);
    letter-spacing: -0.02em;
  }

  .nav-toggle-label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.5rem;
    cursor: pointer;
    justify-content: center;
    border: 0;
    border-radius: 0.75rem;
    background: var(--color-brand-soft);
  }

  .nav-toggle-label .bar {
    display: block;
    height: 0.1875rem;
    border-radius: 999px;
    background: var(--color-primary-dark);
  }

  .site-nav {
    display: none;
    width: 100%;
    order: 3;
    margin-top: 0.65rem;
    padding: 0.5rem 0.75rem 0.75rem;
    border-radius: 1rem;
    background: var(--color-brand-soft);
  }

  .site-nav.is-open {
    display: block;
  }

  .site-nav ul {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .site-nav > ul > li {
    border-top: 1px solid var(--color-brand-tint);
  }

  .site-nav a {
    display: block;
    padding: 0.75rem 0.25rem;
    border-radius: 0.65rem;
    color: var(--color-primary-dark);
    text-decoration: none;
    font-size: var(--text-xs);
    font-weight: 700;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .site-nav a:hover {
    color: var(--color-primary);
    background: var(--color-white);
  }

  .has-children summary {
    padding: 0.75rem 0.25rem;
    font-size: var(--text-xs);
    color: var(--color-primary-dark);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    border-radius: 0.65rem;
  }

  .has-children summary::-webkit-details-marker {
    display: none;
  }

  .has-children summary::after {
    display: inline-block;
    content: '▾';
    margin-inline-start: 0.4rem;
    color: var(--color-ink-soft);
    transition: transform 0.2s ease;
  }

  .has-children details[open] > summary::after {
    transform: rotate(180deg);
  }

  .has-children details[open] > summary {
    color: var(--color-primary);
    background: var(--color-white);
  }

  .submenu {
    padding-inline-start: 1rem;
  }

  .submenu a {
    color: var(--color-ink-soft);
  }

  /* 寬桌面才顯示完整橫向選單，避免中型螢幕硬塞所有導覽項目。 */
  @media (min-width: 1280px) {
    .nav-toggle-label {
      display: none;
    }

    .site-nav {
      display: block;
      width: auto;
      order: 0;
      margin-top: 0;
      padding: 0;
      border-radius: 0;
      background: transparent;
    }

    .site-nav > ul {
      display: flex;
      align-items: center;
      gap: 0.1rem;
      margin: 0;
    }

    .site-nav > ul > li {
      border-top: none;
      position: relative;
    }

    .site-nav a {
      padding: 0.45rem 0.6rem;
      white-space: nowrap;
    }

    .site-nav > ul > li > a:hover,
    .has-children summary:hover,
    .has-children details[open] > summary {
      background: var(--color-brand-soft);
    }

    .has-children summary {
      padding: 0.45rem 0.6rem;
    }

    .has-children details[open] .submenu {
      position: absolute;
      inset-inline-start: 0;
      top: 100%;
      min-width: 16rem;
      max-width: min(22rem, calc(100vw - 2rem));
      background: var(--color-white);
      border: 1px solid var(--color-brand-tint);
      border-radius: 1rem;
      box-shadow: var(--shadow-card-hover);
      padding: 0.65rem;
      z-index: 50;
    }

    .submenu li + li {
      margin-top: 0.125rem;
    }

    .submenu a {
      padding: 0.5rem 0.75rem;
      border-radius: 0.65rem;
      white-space: normal;
      line-height: 1.4;
    }

    .submenu a:hover {
      background: var(--color-brand-soft);
    }
  }
</style>
