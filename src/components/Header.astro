---
// 全站共用頂部導覽。
// 決定（用戶已拍板，見交辦說明與 .source/_ia-plan.md § 3、決定項 9）：
//   9 大項全部攤平放進 header，不比照原站「頂部只露 5 條」的 Google Sites 限制；
//   活動報名專區／線上課程推廣／首頁 用下拉（<details>）收納子頁，全站零 JS。
// 路由對照：逐條取自 .source/_ia-plan.md § 1 路由對照表，一頁不漏、不擅自加頁。
// ⚠ 有 base 子路徑：每一條連結都經 base 組合，不硬編 /xxx。
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

interface NavChild {
  label: string;
  href: string;
}
interface NavItem {
  label: string;
  href: string;
  children?: NavChild[];
}

const nav: NavItem[] = [
  {
    label: '首頁',
    href: base,
    children: [
      { label: '理事長的話', href: `${base}chairman/` },
      { label: '協會章程', href: `${base}charter/` },
      { label: '聯絡我們', href: `${base}contact/` },
      { label: '組織架構與夥伴招募', href: `${base}join-us/` },
    ],
  },
  { label: '最新消息', href: `${base}news/` },
  { label: '加入會員', href: `${base}membership/` },
  {
    label: '活動報名專區',
    href: `${base}events/`,
    children: [
      { label: 'AI醫藥科技媒合平台', href: `${base}events/ai-pharma-tech-matching/` },
      { label: '115年7月AI高校系列初階課程', href: `${base}events/ai-workshop-taichung-tzuchi/` },
      { label: '115年度員榮醫院醫療資訊與臨床應用研討會', href: `${base}events/yuanrung-hospital-seminar/` },
      { label: '亞洲大學附醫專班', href: `${base}events/asia-university-hospital/` },
    ],
  },
  {
    label: '線上課程推廣',
    href: `${base}courses/`,
    children: [
      { label: '115.04.18 醫療人員AI實務應用', href: `${base}courses/2026-04-18-ai-practice/` },
      { label: '115.06.20 醫療人員的AI第二大腦', href: `${base}courses/2026-06-20-second-brain/` },
    ],
  },
  { label: '協同推廣', href: `${base}co-promotion/` },
  { label: '主題專欄', href: `${base}columns/` },
  { label: '官方連結', href: `${base}links/` },
  { label: '免責聲明', href: `${base}disclaimer/` },
];
---

<header class="site-header">
  <div class="header-inner container">
    <a class="logo-link" href={base}>
      <img src={`${base}logo.png`} alt="臺灣遠距藥事照護協會 TTPA" width="48" height="28" />
      <span class="site-title">臺灣遠距藥事照護協會</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="開啟主選單">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </label>

    <nav class="site-nav" aria-label="主要導覽">
      <ul>
        {
          nav.map((item) =>
            item.children ? (
              <li class="has-children">
                <details>
                  <summary>{item.label}</summary>
                  <ul class="submenu">
                    {/* 父層是 <summary> 不是連結，總覽頁若不放進下拉就變成沒有入口的孤兒頁
                        （2026-07-28 獨立複驗抓到 /courses/ 全站無路徑可達）。 */}
                    <li>
                      <a href={item.href}>{item.label === '首頁' ? '首頁' : `${item.label}總覽`}</a>
                    </li>
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href}>{child.label}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            )
          )
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-white);
    border-bottom: 1px solid var(--color-line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    padding-block: 0.75rem;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-primary);
  }

  .logo-link img {
    width: 2.5rem;
    height: auto;
  }

  .site-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-primary);
  }

  /* 漢堡選單：純 CSS checkbox hack，零 JS */
  .nav-toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .nav-toggle-label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.5rem;
    cursor: pointer;
    justify-content: center;
  }

  .nav-toggle-label .bar {
    display: block;
    height: 0.1875rem;
    border-radius: 999px;
    background: var(--color-primary);
  }

  .site-nav {
    display: none;
    width: 100%;
    order: 3;
  }

  .nav-toggle:checked ~ .site-nav {
    display: block;
  }

  .site-nav ul {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .site-nav > ul > li {
    border-top: 1px solid var(--color-line);
  }

  .site-nav a {
    display: block;
    padding: 0.75rem 0.25rem;
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .site-nav a:hover {
    color: var(--color-primary);
  }

  .has-children summary {
    padding: 0.75rem 0.25rem;
    font-size: var(--text-sm);
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
  }

  .has-children summary::-webkit-details-marker {
    display: none;
  }

  .has-children summary::after {
    content: '▾';
    margin-inline-start: 0.4rem;
    color: var(--color-ink-soft);
  }

  .submenu {
    padding-inline-start: 1rem;
  }

  .submenu a {
    color: var(--color-ink-soft);
  }

  /* 桌面版（lg：1024px 起）：橫向導覽列，永遠展開，下拉用 details 點擊收放 */
  @media (min-width: 1024px) {
    .nav-toggle-label {
      display: none;
    }

    .site-nav {
      display: block;
      width: auto;
      order: 0;
    }

    .site-nav > ul {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      margin: 0;
    }

    .site-nav > ul > li {
      border-top: none;
      position: relative;
    }

    .site-nav a {
      padding: 0.5rem 0.75rem;
      white-space: nowrap;
    }

    .has-children summary {
      padding: 0.5rem 0.75rem;
    }

    .has-children details[open] .submenu {
      position: absolute;
      inset-inline-start: 0;
      top: 100%;
      min-width: 16rem;
      background: var(--color-white);
      border: 1px solid var(--color-line);
      border-radius: 0.5rem;
      box-shadow: var(--shadow-card);
      padding: 0.5rem;
      z-index: 50;
    }

    .submenu li + li {
      margin-top: 0.125rem;
    }

    .submenu a {
      padding: 0.5rem 0.75rem;
      border-radius: 0.375rem;
    }

    .submenu a:hover {
      background: var(--color-brand-soft);
    }
  }
</style>
