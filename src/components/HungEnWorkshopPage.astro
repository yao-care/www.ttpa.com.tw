---
import BaseLayout from '../layouts/BaseLayout.astro';

const { event } = Astro.props;
const { title, dateLabel, location, summary, image, registrationLink, contactEmail } = event.data;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${base}${path}`;

const outcomes = [
  ['AI 工作效率', '提升資料整理與日常工作效率'],
  ['醫療簡報與內容', '快速產製專業簡報與衛教素材'],
  ['個人知識管理', '建立自己的知識系統與工作資料庫'],
  ['智慧工作流程', '打造可重複應用的工作流程'],
];

const dayOne = [
  {
    time: '09:30–12:30',
    title: '玩轉 NotebookLM',
    instructor: '黃品叡 醫師',
    detail: '09:30–11:00 課程介紹｜11:00–12:00 分組實作｜12:00–12:30 成果展示與 Q&A',
  },
  {
    time: '12:30–13:30',
    title: '午餐時間',
    instructor: '',
    detail: '',
  },
  {
    time: '13:30–16:30',
    title: '從 ChatGPT 到 Codex 智慧工作流程',
    instructor: '蔡秀敏 專科護理師',
    detail: '13:30–15:00 課程介紹｜15:00–16:00 分組實作｜16:00–16:30 成果展示與 Q&A',
  },
];

const dayTwo = [
  {
    time: '09:30–12:30',
    title: 'Gemini 臨床簡報實務應用',
    instructor: '翁紹恩 主任／歪樓藥師',
    detail: '09:30–11:00 課程介紹｜11:00–12:00 分組實作｜12:00–12:30 成果展示與 Q&A',
  },
  {
    time: '12:30–13:30',
    title: '午餐時間',
    instructor: '',
    detail: '',
  },
  {
    time: '13:30–16:30',
    title: 'Notion × AI 第二大腦',
    instructor: '陳晏緹 專科護理師',
    detail: '13:30–15:00 課程介紹｜15:00–16:00 分組實作｜16:00–16:30 成果展示與 Q&A',
  },
  {
    time: '16:30–17:00',
    title: '初階課程結訓／證書',
    instructor: '',
    detail: '完成兩日課程並通過結訓，即可獲得研習證書。',
  },
];

const faculty = [
  {
    image: 'img/instructor-huang-pinrui.webp',
    imageAlt: '黃品叡醫師形象照',
    name: '黃品叡 醫師',
    topic: '玩轉 NotebookLM',
    credentials: ['大甲李綜合醫院醫療部', '泌尿外科碎石中心主任', '大甲李綜合醫院教學部主治醫師'],
  },
  {
    image: 'img/instructor-weng-shaoen.webp',
    imageAlt: '翁紹恩主任形象照',
    name: '翁紹恩 主任／歪樓藥師',
    topic: 'Gemini 臨床簡報實務應用',
    credentials: ['臺北市立聯合醫院中興院區藥劑科主任', '台灣實證醫學學會理事', '台灣實證醫學學會青年委員會主委'],
  },
  {
    image: 'img/instructor-chen-yanti.jpg',
    imageAlt: '陳晏緹專科護理師形象照',
    name: '陳晏緹 專科護理師',
    topic: 'Notion × AI 第二大腦',
    credentials: ['喜悅健康診所', '專科護理師', '自媒體創作家'],
  },
  {
    image: 'img/instructor-tsai-hsiu-min.webp',
    imageAlt: '蔡秀敏專科護理師形象照',
    name: '蔡秀敏 專科護理師',
    topic: '從 ChatGPT 到 Codex 智慧工作流程',
    credentials: ['輔仁大學附設醫院護理部／外科加護病房', '專科護理師', '協會行銷創作人員'],
  },
];

const plans = [
  ['一般身分原價', 'NT$6,600', '兩日課程'],
  ['早鳥優惠', 'NT$6,000', '2026/10/18 前'],
  ['協作單位／TTPA 會員', 'NT$5,500', '符合資格者'],
  ['大學醫事相關學生', 'NT$4,950', '75 折，須提供學生證明'],
  ['團體優惠', '每人再折 NT$500', '3 人以上，須提供同行者姓名'],
  ['溫故知新方案', 'NT$1,980', '曾參與本系列課程者'],
];

const refundRows = [
  ['2026/10/15 以前', '100% 退費', '學員負擔 NT$100 手續費'],
  ['2026/10/16–10/30', '80% 退費', '學員負擔 NT$100 手續費'],
  ['2026/10/31–11/06', '50% 退費', '學員負擔 NT$100 手續費'],
  ['2026/11/07–11/13', '不予退費', '不接受任何退費申請'],
  ['2026/11/14 以後', '不予退費', '視為自動放棄，不退費'],
];

const posters = [
  ['img/ai-workshop-hung-en-2026-overview.jpg', '活動總覽', 'AI 高效工作坊活動總覽海報'],
  ['img/ai-workshop-hung-en-2026-schedule.jpg', '課程時間表', 'AI 高效工作坊雙日課程時間表'],
  ['img/ai-workshop-hung-en-2026-fees.jpg', '費用與退費', 'AI 高效工作坊課程費用與退費機制'],
  ['img/ai-workshop-hung-en-2026-faculty.jpg', '講師陣容', 'AI 高效工作坊講師陣容'],
];
---

<BaseLayout title={`${title}｜臺灣遠距藥事照護協會`} description={summary}>
  <nav class="workshop-nav" aria-label="本頁導覽">
    <div class="container workshop-nav-inner">
      <a class="workshop-brand" href="#top"><span aria-hidden="true">AI</span> 高效工作坊</a>
      <div class="workshop-links">
        <a href="#outcomes">課程特色</a>
        <a href="#schedule">課程表</a>
        <a href="#faculty">講師群</a>
        <a href="#pricing">費用與退費</a>
      </div>
      <a class="workshop-state" href={registrationLink} target="_blank" rel="noopener noreferrer">開放報名</a>
    </div>
  </nav>

  <main id="top" class="workshop-page">
    <section class="hero">
      <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
      <div class="hero-orb hero-orb-two" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow"><span aria-hidden="true"></span> 台北場 · 現正報名中</p>
          <h1>AI 高效工作坊<br /><em>醫藥護專業人員的實務應用</em></h1>
          <p class="hero-summary">{summary}</p>
          <dl class="hero-facts" aria-label="活動資訊">
            <div><dt>日期時間</dt><dd>{dateLabel}</dd></div>
            <div><dt>活動地點</dt><dd>{location}</dd></div>
          </dl>
          <div class="hero-actions">
            <a class="button button-primary" href={registrationLink} target="_blank" rel="noopener noreferrer">立即線上報名 <span aria-hidden="true">→</span></a>
            <a class="button button-ghost" href="#schedule">查看課程內容</a>
          </div>
          <p class="hero-note">雙日實體課程｜實作導向｜完成課程可依規定取得學分與研習證書</p>
        </div>

        <a class="hero-visual" href={asset(image)} target="_blank" rel="noopener noreferrer" aria-label="開啟完整活動海報">
          <div class="hero-image-frame">
            <img src={asset(image)} alt="AI 高效工作坊宏恩綜合醫院場活動海報" width="1414" height="2000" />
            <span class="image-label">點擊查看完整活動海報</span>
          </div>
          <div class="floating-card floating-card-top"><span>2</span> 天密集實作</div>
          <div class="floating-card floating-card-bottom"><span>4</span> 大實務主題</div>
        </a>
      </div>
    </section>

    <section class="service-strip" aria-label="課程重點">
      <div class="container service-grid">
        <span>✓ 實作導向</span>
        <span>✓ 貼近醫療現場</span>
        <span>✓ 學完即可應用</span>
      </div>
    </section>

    <section class="section outcomes" id="outcomes">
      <div class="container">
        <header class="section-heading" data-reveal>
          <p class="eyebrow">COURSE OUTCOMES</p>
          <h2>兩天建立四項可直接應用的能力</h2>
          <p>從單一工具操作一路延伸至可重複使用的個人 AI 工作流程。</p>
        </header>
        <div class="outcome-grid">
          {outcomes.map(([title, text], index) => (
            <article data-reveal data-delay={String(index)}><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></article>
          ))}
        </div>
        <div class="credit-strip" data-reveal>
          <div><strong>12 學分</strong><span>台灣臨床藥學會</span></div>
          <div><strong>12 學分</strong><span>護理師持續教育積分</span></div>
          <div><strong>16 小時</strong><span>遠距藥事訓練證書</span></div>
        </div>
      </div>
    </section>

    <section class="section schedule" id="schedule">
      <div class="container">
        <header class="section-heading" data-reveal>
          <p class="eyebrow">TWO-DAY PROGRAM</p>
          <h2>雙日實作課程表</h2>
          <p>每日 09:30–17:00，以課程說明、分組實作、成果展示與 Q&A 完成學習循環。</p>
        </header>
        <div class="schedule-grid">
          {[{ day: 'Day 1', date: '11/14（六）', theme: '從資料整理到智慧工作流程', items: dayOne }, { day: 'Day 2', date: '11/15（日）', theme: '建立個人知識系統與可重複工作流程', items: dayTwo }].map((schedule, index) => (
            <article class="day-card" data-reveal data-delay={String(index)}>
              <header><div><span>{schedule.day}</span><h3>{schedule.date}</h3></div><p>{schedule.theme}</p></header>
              <ol>
                {schedule.items.map((item) => (
                  <li class:list={{ break: item.title === '午餐時間' }}>
                    <time>{item.time}</time>
                    <div><strong>{item.title}</strong>{item.instructor && <span>{item.instructor}</span>}{item.detail && <small>{item.detail}</small>}</div>
                  </li>
                ))}
              </ol>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section faculty" id="faculty">
      <div class="container">
        <header class="section-heading" data-reveal>
          <p class="eyebrow">FACULTY</p>
          <h2>醫療專業 × AI 實務講師群</h2>
          <p>由醫師、藥師與專科護理師，帶領四大主題的情境實作。</p>
        </header>
        <div class="faculty-grid">
          {faculty.map((person, index) => (
            <article class="faculty-card" data-reveal data-delay={String(index)}>
              <div class="faculty-photo">
                <img src={asset(person.image)} alt={person.imageAlt} width="1000" height="1500" loading="lazy" />
              </div>
              <div class="faculty-copy">
                <p class="faculty-topic">{person.topic}</p>
                <h3>{person.name}</h3>
                <ul>{person.credentials.map((credential) => <li>{credential}</li>)}</ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section pricing" id="pricing">
      <div class="container">
        <header class="section-heading" data-reveal>
          <p class="eyebrow">REGISTRATION</p>
          <h2>報名費用與優惠方案</h2>
          <p>請依身分選擇方案；資格與繳費資訊以報名表單審核結果為準。</p>
        </header>
        <div class="pricing-grid">
          {plans.map(([label, price, note], index) => (
            <article class:list={['price-card', { featured: index === 1 }]} data-reveal data-delay={String(index % 4)}>
              {index === 1 && <span class="plan-tag">早鳥至 10/18</span>}
              <h3>{label}</h3><strong>{price}</strong><p>{note}</p>
            </article>
          ))}
        </div>
        <div class="partner-note" data-reveal>
          <strong>協作單位優惠適用：</strong>
          <span>財團法人中華藥學研究基金會、CNUP 全國藥學領袖人才培訓社、宏恩醫療財團法人宏恩綜合醫院。</span>
        </div>
      </div>
    </section>

    <section class="refund" aria-labelledby="refund-title">
      <div class="container narrow">
        <details class="refund-details" data-reveal>
          <summary>
            <span><small>課程異動說明</small><strong id="refund-title">退費機制與注意事項</strong></span>
            <i aria-hidden="true">展開查看 ＋</i>
          </summary>
          <div class="refund-content">
            <div class="table-wrap">
              <table>
                <thead><tr><th>申請日期</th><th>退費比例</th><th>說明</th></tr></thead>
                <tbody>{refundRows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
              </table>
            </div>
            <ul class="policy-notes">
              <li>退費申請可透過課程 LINE 群組或協會電子郵件提出，款項於核准後 7 個工作天內處理。</li>
              <li>若因不可抗力因素致課程無法正常進行，將全額退費或提供轉期選擇。</li>
              <li>需轉讓名額者，須於課程開始前 7 天辦理並經協會秘書處審核。</li>
              <li>參與線上課程人員請勿翻拍、側錄或擅自轉傳課程內容。</li>
            </ul>
          </div>
        </details>
      </div>
    </section>

    <section class="section poster-gallery" id="poster-gallery">
      <div class="container">
        <header class="section-heading" data-reveal>
          <p class="eyebrow">EVENT GUIDE</p>
          <h2>完整活動資訊海報</h2>
          <p>點擊任一張圖片，可開啟原尺寸查看細節。</p>
        </header>
        <div class="poster-grid">
          {posters.map(([src, label, alt], index) => (
            <a href={asset(src)} target="_blank" rel="noopener noreferrer" data-reveal data-delay={String(index)}>
              <img src={asset(src)} alt={alt} width="1414" height="2000" loading="lazy" />
              <span>{label}<i aria-hidden="true">↗</i></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="closing">
      <div class="container closing-inner" data-reveal>
        <div><p class="eyebrow">REGISTER NOW</p><h2>準備把 AI 放進你的日常工作？</h2><p>完成線上報名、資格審核與繳費後，即完成本次課程報名。</p></div>
        <a class="button button-light" href={registrationLink} target="_blank" rel="noopener noreferrer">前往 Google 表單 <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="organizers" aria-label="主協辦單位與聯絡資訊">
      <div class="container organizer-grid">
        <div><strong>主辦單位</strong><span>臺灣遠距藥事照護協會</span></div>
        <div><strong>協辦單位</strong><span>宏恩醫療財團法人宏恩綜合醫院、中華藥學研究基金會、CNUP 全國藥學領袖人才培訓社</span></div>
        <div><strong>聯絡信箱</strong><a href={`mailto:${contactEmail}`}>{contactEmail}</a></div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reducedMotion || !('IntersectionObserver' in window)) {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -5% 0px' });
    revealItems.forEach((item) => observer.observe(item));
  }
</script>

<style>
  .workshop-page { overflow: clip; background: var(--color-white); }
  .workshop-nav { position: sticky; top: var(--site-header-height); z-index: 30; border-bottom: 1px solid var(--color-workshop-a20); background: color-mix(in srgb, var(--color-white) 94%, transparent); box-shadow: var(--shadow-card); backdrop-filter: blur(.8rem); }
  .workshop-nav-inner { display: flex; min-height: 4.6rem; align-items: center; justify-content: space-between; gap: 1rem; }
  .workshop-brand { display: inline-flex; align-items: center; gap: .6rem; color: var(--color-workshop-dark); font-weight: 800; text-decoration: none; white-space: nowrap; }
  .workshop-brand span { display: grid; width: 2.6rem; height: 2.6rem; place-items: center; border-radius: .8rem; background: linear-gradient(135deg, var(--color-workshop), var(--color-workshop-dark)); color: var(--color-white); font-size: var(--text-xs); }
  .workshop-links { display: none; align-items: center; gap: 1.25rem; }
  .workshop-links a { color: var(--color-ink-soft); font-size: var(--text-xs); font-weight: 700; text-decoration: none; }
  .workshop-links a:hover, .workshop-links a:focus-visible { color: var(--color-workshop); }
  .workshop-state { padding: .58rem .95rem; border-radius: 999rem; background: var(--color-workshop); color: var(--color-white); font-size: var(--text-xs); font-weight: 800; text-decoration: none; white-space: nowrap; }
  .container { width: min(100% - 2rem, 75rem); margin-inline: auto; }
  .narrow { max-width: 62rem; }
  .hero { position: relative; padding-block: clamp(3.5rem, 8vw, 7rem); background: linear-gradient(145deg, var(--color-workshop-soft), var(--color-white) 66%); }
  .hero-grid { position: relative; z-index: 1; display: grid; gap: 3rem; align-items: center; }
  .hero-orb { position: absolute; border-radius: 50%; background: var(--color-workshop-a10); filter: blur(1rem); pointer-events: none; }
  .hero-orb-one { width: 25rem; height: 25rem; top: -10rem; right: -7rem; }
  .hero-orb-two { width: 16rem; height: 16rem; bottom: -8rem; left: -5rem; }
  .eyebrow { margin: 0 0 .8rem; color: var(--color-workshop); font-size: var(--text-xs); font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .hero-copy > .eyebrow { display: flex; align-items: center; gap: .6rem; }
  .hero-copy > .eyebrow span { width: .65rem; height: .65rem; border-radius: 50%; background: var(--color-workshop); box-shadow: 0 0 0 .4rem var(--color-workshop-a10); }
  .hero h1 { margin: 0; color: var(--color-workshop-dark); font-size: var(--text-2xl); line-height: 1.12; letter-spacing: -.025em; }
  .hero h1 em { color: var(--color-workshop); font-style: normal; }
  .hero-summary { max-width: 42rem; margin: 1.5rem 0; color: var(--color-ink-soft); font-size: var(--text-lg); }
  .hero-facts { display: grid; gap: .85rem; margin: 0; padding: 1.1rem 0; border-block: 1px solid var(--color-workshop-tint); }
  .hero-facts div { display: grid; grid-template-columns: 5rem 1fr; gap: .75rem; align-items: start; }
  .hero-facts dt { color: var(--color-workshop-dark); font-weight: 800; }
  .hero-facts dd { margin: 0; color: var(--color-ink-soft); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.5rem; }
  .button { display: inline-flex; min-height: 3.5rem; align-items: center; justify-content: center; gap: .5rem; padding: .75rem 1.4rem; border: 1px solid transparent; border-radius: .85rem; font-weight: 800; text-decoration: none; transition: transform .2s ease, box-shadow .2s ease, background .2s ease; }
  .button:hover, .button:focus-visible { transform: translateY(-.15rem); box-shadow: var(--shadow-card-hover); }
  .button-primary { background: var(--color-workshop); color: var(--color-white); }
  .button-primary:hover, .button-primary:focus-visible { background: var(--color-workshop-dark); color: var(--color-white); }
  .button-ghost { border-color: var(--color-workshop-tint); background: var(--color-white); color: var(--color-workshop-dark); }
  .hero-note { margin: 1rem 0 0; color: var(--color-ink-muted); font-size: var(--text-xs); }
  .hero-visual { position: relative; display: block; width: min(100%, 29rem); margin-inline: auto; padding: 1rem; color: inherit; text-decoration: none; }
  .hero-image-frame { overflow: hidden; border: .6rem solid var(--color-white); border-radius: 2rem; background: var(--color-white); box-shadow: var(--shadow-card-hover); transform: rotate(1.2deg); transition: transform .35s ease; }
