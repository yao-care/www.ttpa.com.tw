  ['10:00–11:00', '醫療 AI × 藥局未來', '李世揚 藥師'],
  ['11:00–12:00', '科技輔具 × AI 應用', '霍恩實業有限公司（黃信銘 理事）'],
  ['12:00–13:00', '用餐', '—'],
  ['13:00–14:00', 'AI 導購與會員經營', '吉格線股份有限公司（方敬霖）'],
  ['14:00–15:00', '科技輔具 × AI 應用', '蘊域科技股份有限公司'],
  ['15:00–15:30', '【加碼議程】AI Pet Pharmacy 寵物友善智慧藥局', 'PetTalk'],
  ['15:30–17:00', '數位藥事實務參觀', '中山醫學大學附設醫院藥劑科'],
  ['17:00–17:30', '總結、歸賦', '—'],
