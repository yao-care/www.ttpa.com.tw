            <div><strong>地點</strong><span>中山醫學大學附設醫院</span></div>
          </div>
          <div class="hero-actions">
            <a class="button button-primary" href={registrationLink} target="_blank" rel="noopener noreferrer">立即線上報名 <span aria-hidden="true">→</span></a>
            <a class="button button-ghost" href="#series">認識系列活動</a>
          </div>
          <p class="deadline"><span aria-hidden="true">●</span> 報名至 2026 年 8 月 17 日（一）止</p>
        </div>

        <div class="hero-visual" data-reveal data-delay="1">
          <div class="hero-image-frame">
            <img src={asset(image)} alt="AI 醫藥科技媒合平台與會夥伴於活動現場合影" width="1600" height="900" />
            <span class="image-label">醫藥現場 × AI 解方 × 跨域媒合</span>
          </div>
          <a class="qr-card" href={registrationLink} target="_blank" rel="noopener noreferrer" aria-label="掃描或點擊 QR Code 前往 AI 醫藥科技媒合平台二部曲報名表">
            <img src={asset('img/ai-platform-registration-qr.png')} alt="AI 醫藥科技媒合平台二部曲報名 QR Code" width="480" height="480" />
            <span><strong>掃碼報名</strong><small>08/22 二部曲</small></span>
          </a>
          <div class="floating-card"><span>2</span> 場跨域實務交流</div>
        </div>
