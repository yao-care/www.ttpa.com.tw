---
import BaseLayout from '../layouts/BaseLayout.astro';

const { event } = Astro.props;
const { title, summary, image, registrationLink } = event.data;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${base}${path}`;

const partners = [
  { image: 'logo.png', name: '臺灣遠距藥事照護協會', className: 'partner-mark' },
  { image: 'img/partner-pharmacist-assoc.png', name: '臺灣社區藥學會' },
  { image: 'img/partner-yuanrung.png', name: '員榮醫療社團法人員榮醫院' },
  { image: 'img/ai-platform-csmuh.png', name: '中山醫學大學附設醫院', className: 'partner-wide' },
  { image: 'img/partner-cnup.png', name: 'CNUP 全國藥學領袖人才培訓社' },
];

const phaseOneTopics = [
  {
    number: '01',
    title: 'AI 智慧社區藥局經營交流',
    text: '從一線藥局的真實情境出發，找出值得被科技解決的問題。',
    items: ['藥局經營與服務痛點盤點', '科技媒合成果與案例分享', '跨域夥伴深度交流'],
  },
  {
    number: '02',
    title: 'AI 醫療應用實務培訓',
    text: '把概念帶進操作情境，讓醫藥與科技團隊建立共同語言。',
    items: ['系統功能與流程操作', '社區藥局情境模擬', '即時問答與實作回饋'],
  },
];

const phaseOneGallery = [
  {
    image: 'img/results/ai-pharma-tech-matching/session-overview.webp',
    alt: 'AI 醫藥科技媒合平台交流會全場活動紀錄',
    caption: '專題分享凝聚醫藥現場與科技團隊的共同問題意識。',
  },
  {
    image: 'img/results/ai-pharma-tech-matching/solution-showcase.webp',
    alt: '科技團隊於交流會現場展示藥局系統解決方案',
    caption: '開發團隊展示藥局系統，讓功能與場域需求直接對話。',
  },
  {
    image: 'img/results/ai-pharma-tech-matching/system-discussion.webp',
    alt: '與會者圍繞設備進行系統操作與交流',
    caption: '參與者實際檢視操作流程，提出第一線使用回饋。',
  },
];

const phaseTwoHighlights = [
  { icon: '⌘', title: '手把手教案與實作', text: '以可跟著完成的操作流程，帶你理解 AI 如何進入藥事服務與日常經營。' },
  { icon: '◎', title: '專家實務經驗分享', text: '從醫院、社區藥局到科技團隊，直接拆解導入過程與常見挑戰。' },
