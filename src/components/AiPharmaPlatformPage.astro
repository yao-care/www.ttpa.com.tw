          <button id="tab-phase-one" type="button" role="tab" aria-selected="false" aria-controls="panel-phase-one" tabindex="-1">06/06 首部曲 <span>已完成</span></button>
        </div>

        <div id="panel-phase-two" class="schedule-panel" role="tabpanel" aria-labelledby="tab-phase-two" tabindex="0" data-reveal>
          <div class="schedule-intro"><div><span>PHASE 02</span><h3>AI 智慧藥事實作與場域參訪</h3></div><p>2026/08/22 · 中山醫學大學附設醫院</p></div>
          <div class="schedule-table-wrap">
            <table><thead><tr><th>時間</th><th>主題</th><th>講者／單位</th></tr></thead><tbody>{phaseTwoSchedule.map(([time, topic, speaker]) => <tr><td>{time}</td><td>{topic}</td><td>{speaker}</td></tr>)}</tbody></table>
          </div>
        </div>

        <div id="panel-phase-one" class="schedule-panel" role="tabpanel" aria-labelledby="tab-phase-one" tabindex="0" hidden>
          <div class="schedule-intro"><div><span>PHASE 01</span><h3>AI 智慧社區藥局交流與實務培訓</h3></div><p>2026/06/06 · 員榮醫院員生院區</p></div>
          <div class="schedule-table-wrap">
            <table><thead><tr><th>時間</th><th>主題</th><th>講者／單位</th></tr></thead><tbody>{phaseOneSchedule.map(([time, topic, speaker]) => <tr><td>{time}</td><td>{topic}</td><td>{speaker}</td></tr>)}</tbody></table>
