          <div><dt>協辦單位</dt><dd>員榮醫療社團法人員榮醫院、中山醫學大學附設醫院、CNUP 全國藥學領袖人才培訓社</dd></div>
        </dl>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reducedMotion || !('IntersectionObserver' in window)) {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
    revealItems.forEach((item) => observer.observe(item));
  }

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const activateTab = (tab: HTMLButtonElement) => {
    tabs.forEach((item) => {
      const selected = item === tab;
      item.setAttribute('aria-selected', String(selected));
      item.tabIndex = selected ? 0 : -1;
      const panel = document.getElementById(item.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !selected;
    });
    tab.focus();
  };
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activateTab(tab));
    tab.addEventListener('keydown', (event) => {
      let nextIndex = index;
      if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
      if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
      if (event.key === 'Home') nextIndex = 0;
      if (event.key === 'End') nextIndex = tabs.length - 1;
      if (nextIndex !== index) {
        event.preventDefault();
        activateTab(tabs[nextIndex]);
      }
    });
  });
</script>

<style>
  .platform-page { overflow: clip; background: var(--color-white); }
  .container { width: min(100% - 2rem, 75rem); margin-inline: auto; }
  .platform-nav { position: sticky; top: var(--site-header-height); z-index: 30; border-bottom: 1px solid var(--color-workshop-a20); background: var(--color-white); box-shadow: var(--shadow-card); }
  .platform-nav-inner { display: flex; min-height: 4.6rem; align-items: center; justify-content: space-between; gap: 1rem; }
  .platform-brand { display: inline-flex; align-items: center; gap: .6rem; color: var(--color-workshop-dark); font-weight: 800; text-decoration: none; white-space: nowrap; }
  .platform-brand span { display: grid; width: 2.6rem; height: 2.6rem; place-items: center; border-radius: .8rem; background: linear-gradient(135deg, var(--color-workshop), var(--color-accent)); color: var(--color-white); font-size: var(--text-xs); }
  .platform-links { display: none; align-items: center; gap: 1.4rem; }
  .platform-links a { color: var(--color-ink-soft); font-size: var(--text-xs); font-weight: 700; text-decoration: none; transition: color .2s ease; }
  .platform-links a:hover, .platform-links a:focus-visible { color: var(--color-workshop); }
  .platform-register { padding: .7rem 1rem; border-radius: .8rem; background: var(--color-workshop); color: var(--color-white); font-size: var(--text-xs); font-weight: 800; text-decoration: none; white-space: nowrap; transition: background .2s ease, transform .2s ease; }
  .platform-register:hover, .platform-register:focus-visible { background: var(--color-workshop-dark); color: var(--color-white); transform: translateY(-.1rem); }
  .hero { position: relative; padding-block: clamp(4rem, 9vw, 7.5rem); background: linear-gradient(145deg, var(--color-workshop-soft), var(--color-white)); }
  .hero-grid-lines { position: absolute; inset: 0; opacity: .45; background-image: linear-gradient(var(--color-workshop-a10) 1px, transparent 1px), linear-gradient(90deg, var(--color-workshop-a10) 1px, transparent 1px); background-size: 3rem 3rem; mask-image: linear-gradient(to bottom, black, transparent 78%); pointer-events: none; }
  .hero-grid { position: relative; z-index: 1; display: grid; gap: 3.5rem; align-items: center; }
  .hero-orb { position: absolute; border-radius: 50%; filter: blur(1rem); pointer-events: none; }
  .hero-orb-one { width: 24rem; height: 24rem; top: -10rem; right: -8rem; background: var(--color-workshop-a10); }
  .hero-orb-two { width: 14rem; height: 14rem; bottom: -5rem; left: -4rem; background: var(--color-workshop-a10); }
  .eyebrow { margin: 0 0 .8rem; color: var(--color-workshop); font-size: var(--text-xs); font-weight: 800; letter-spacing: .08em; }
  .hero-copy > .eyebrow { display: flex; align-items: center; gap: .6rem; }
  .hero-copy > .eyebrow span { width: .65rem; height: .65rem; border-radius: 50%; background: var(--color-accent); box-shadow: 0 0 0 .4rem var(--color-workshop-a10); }
  .hero h1 { margin: 0; color: var(--color-workshop-dark); font-size: var(--text-2xl); line-height: 1.1; letter-spacing: -.025em; }
  .hero h1 em { color: var(--color-workshop); font-style: normal; }
  .hero-summary { max-width: 43rem; margin: 1.5rem 0; color: var(--color-ink-soft); font-size: var(--text-lg); }
  .hero-facts { display: grid; gap: .75rem; padding: 1rem 0; border-block: 1px solid var(--color-workshop-tint); }
  .hero-facts div { display: grid; grid-template-columns: 4rem 1fr; gap: .75rem; align-items: start; }
  .hero-facts strong { color: var(--color-workshop-dark); }
  .hero-facts span { color: var(--color-ink-soft); }
